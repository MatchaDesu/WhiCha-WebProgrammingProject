<section class="px-6 py-12">
  <div class="container mx-auto max-w-3xl flex flex-col gap-8">

    <div class="flex flex-col items-center gap-4">
      <h1 class="text-3xl md:text-4xl text-center leading-tight">
        สร้าง<span class="text-accent">คอร์สใหม่</span>
      </h1>
      <p class="text-center md:text-xl text-gray-600">
        กรอกข้อมูลพื้นฐานของคอร์สก่อน จากนั้นคุณสามารถเพิ่มบทเรียนและแบบทดสอบได้
      </p>
    </div>

    <div class="w-12 h-0.5 bg-gray-400 mx-auto"></div>

    <form action="/instructor/courses/create" 
          method="POST"
          class="flex flex-col gap-8 w-full mt-4">

      <div class="flex flex-col gap-2">
        <label class="md:text-xl font-semibold">
          ชื่อคอร์ส *
        </label>
        <input 
          type="text" 
          name="course_name"
          required
          class="w-full border px-4 py-3 focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition"
          placeholder="เช่น Complete Node.js Bootcamp"
        >
      </div>

      <div class="flex flex-col gap-2">
        <label class="md:text-xl font-semibold">
          หมวดหมู่ *
        </label>
        <select 
          name="category_id"
          required
          class="w-full border px-4 py-3 focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition bg-white"
        >
          <option value="">-- เลือกหมวดหมู่ --</option>
          <% categories.forEach(category => { %>
            <option value="<%= category.category_id %>">
              <%= category.category_name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="flex flex-col gap-2">
        <label class="md:text-xl font-semibold">
          คำอธิบายคอร์ส
        </label>
        <textarea 
          name="description"
          rows="5"
          class="w-full border px-4 py-3 focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition"
          placeholder="อธิบายว่าคอร์สนี้จะสอนอะไร เหมาะกับใคร..."
        ></textarea>
      </div>

      <div class="flex flex-col md:flex-row gap-8">
        <div class="flex flex-col gap-2 w-full md:w-1/2">
          <label class="md:text-xl font-semibold">
            ราคาคอร์ส (บาท)
          </label>
          <input 
            type="number"
            name="course_price"
            min="0"
            value="0"
            class="w-full border px-4 py-3 focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition"
          >
        </div>

        <div class="flex flex-col gap-2 w-full md:w-1/2">
          <label class="md:text-xl font-semibold">
            รูปปกคอร์ส
          </label>
          <input 
            type="file"
            name="course_image"
            accept="image/*"
            class="w-full border px-4 py-3 bg-white focus:outline-none focus:border-black transition cursor-pointer"
          >
        </div>
      </div>

      <div class="w-12 h-0.5 bg-gray-400 mx-auto my-4"></div>

      <div class="flex flex-col md:flex-row justify-center gap-4">

        <button 
          type="submit" 
          name="action"
          value="draft"
          class="px-8 py-3 border border-gray-400 hover:bg-gray-100 font-semibold transition"
        >
          บันทึกเป็น Draft
        </button>

        <button 
          type="submit"
          name="action"
          value="continue"
          class="px-8 py-3 bg-black text-white hover:opacity-80 font-semibold transition shadow-md"
        >
          บันทึกและไปจัดการเนื้อหา →
        </button>

      </div>

    </form>

  </div>
</section>