<section class="bg-gray-50 min-h-screen pb-16">
  <div class="container mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-3xl flex flex-col gap-6">

    <div>
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900 leading-tight">
        สร้างคอร์สใหม่
      </h1>
      <p class="text-gray-500 mt-2 text-sm md:text-base">
        กรอกข้อมูลพื้นฐานของคอร์สก่อน จากนั้นคุณสามารถเพิ่มบทเรียนและแบบทดสอบได้
      </p>
    </div>

    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 sm:p-8">
      
      <form action="/instructor/courses/create" 
            method="POST" 
            class="flex flex-col gap-6 w-full">

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">
            ชื่อคอร์ส <span class="text-red-500">*</span>
          </label>
          <input 
            type="text" 
            name="course_name"
            required
            class="w-full bg-gray-50 border border-gray-200 text-gray-900 rounded-lg px-4 py-2.5 text-sm placeholder-gray-400 focus:bg-white focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition"
            placeholder="เช่น Complete Node.js Bootcamp"
          >
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">
            หมวดหมู่ <span class="text-red-500">*</span>
          </label>
          <select 
            name="category_id"
            required
            class="w-full bg-gray-50 border border-gray-200 text-gray-900 rounded-lg px-4 py-2.5 text-sm focus:bg-white focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition appearance-none"
          >
            <option value="" disabled selected>-- เลือกหมวดหมู่ --</option>
            <% categories.forEach(category => { %>
              <option value="<%= category.category_id %>">
                <%= category.category_name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">
            คำอธิบายคอร์ส
          </label>
          <textarea 
            name="description"
            rows="5"
            class="w-full bg-gray-50 border border-gray-200 text-gray-900 rounded-lg px-4 py-2.5 text-sm placeholder-gray-400 focus:bg-white focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition"
            placeholder="อธิบายว่าคอร์สนี้จะสอนอะไร เหมาะกับใคร หรือนักเรียนจะได้เรียนรู้อะไรบ้าง..."
          ></textarea>
        </div>

        <div class="flex flex-col sm:flex-row gap-6">
          <div class="w-full sm:w-1/2">
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              ราคาคอร์ส (บาท)
            </label>
            <div class="relative">
              <input 
                type="number"
                name="course_price"
                min="0"
                value="0"
                class="w-full bg-gray-50 border border-gray-200 text-gray-900 rounded-lg pl-4 pr-10 py-2.5 text-sm focus:bg-white focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition"
              >
              <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm pointer-events-none">฿</span>
            </div>
          </div>
        </div>

        <hr class="border-gray-200 my-2">

        <div class="flex flex-col-reverse sm:flex-row justify-end gap-3 pt-2">
          
          <button 
            type="submit" 
            name="action"
            value="draft"
            class="w-full sm:w-auto px-6 py-2.5 bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 hover:text-black font-medium rounded-lg transition shadow-sm text-sm"
          >
            บันทึกเป็นฉบับร่าง
          </button>

          <button 
            type="submit"
            name="action"
            value="continue"
            class="w-full sm:w-auto px-6 py-2.5 bg-black border border-black text-white hover:bg-gray-800 font-medium rounded-lg transition shadow-sm text-sm flex items-center justify-center gap-2"
          >
            บันทึกและไปต่อ
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>

        </div>

      </form>
    </div>

  </div>
</section>