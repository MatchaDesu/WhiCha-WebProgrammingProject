<section id="instructor-courses" class="bg-gray-50 min-h-screen pb-16">
  <div class="container mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-6xl flex flex-col gap-8">

    <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-6 pb-6 border-b border-gray-200">
      <div>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 leading-tight">
          จัดการคอร์สเรียน
        </h1>
        <p class="text-gray-500 mt-2 text-sm md:text-base">
          คอร์สทั้งหมดที่คุณสร้างขึ้น (คอร์สที่เผยแพร่แล้วจะไม่สามารถแก้ไขเนื้อหาได้)
        </p>
      </div>

      <a href="/instructor/create-course" class="w-full md:w-auto px-6 py-2.5 bg-black text-white hover:bg-gray-800 transition shadow-sm font-medium text-center shrink-0 rounded-lg flex items-center justify-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        สร้างคอร์สใหม่
      </a>
    </div>

    <% 
      const publishedCourses = courses.filter(c => c.course_status === 'published');
      const pendingCourses   = courses.filter(c => c.course_status === 'pending');
      const draftCourses     = courses.filter(c => c.course_status === 'draft');
      const archivedCourses  = courses.filter(c => c.course_status === 'archived');
    %>

    <% if (!courses || courses.length === 0) { %>

    <div class="flex flex-col items-center justify-center py-20 px-4 border border-dashed border-gray-300 bg-white rounded-xl shadow-sm">
      <div class="w-16 h-16 bg-gray-50 border border-gray-100 rounded-2xl flex items-center justify-center mb-5 text-gray-400">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
      </div>
      <h2 class="text-xl font-bold mb-2 text-center text-gray-900">
        ยังไม่มีคอร์สเรียน
      </h2>
      <p class="text-gray-500 mb-8 text-center max-w-sm text-sm">
        คุณยังไม่ได้สร้างคอร์สใดๆ เริ่มต้นสร้างและแบ่งปันความรู้ของคุณได้เลยตอนนี้
      </p>
      <a href="/instructor/create-course" class="w-full sm:w-auto px-6 py-2.5 bg-black text-white hover:bg-gray-800 transition font-medium shadow-sm rounded-lg text-center text-sm">
        สร้างคอร์สแรกของคุณ
      </a>
    </div>

    <% } else { %>

    <div class="flex flex-col gap-10">

      <% if (pendingCourses.length > 0) { %>
      <div>
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
          รอการอนุมัติ (<%= pendingCourses.length %>)
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

          <% pendingCourses.forEach(course => { %>
          <div class="group border border-gray-200 overflow-hidden hover:shadow-md hover:border-gray-300 transition duration-300 bg-white flex flex-col sm:flex-row rounded-xl h-full">

            <div class="w-full sm:w-48 shrink-0 h-48 sm:h-auto relative bg-gray-100 border-b sm:border-b-0 sm:border-r border-gray-100 overflow-hidden">
              <% if (course.course_image) { %>
              <img src="<%= course.course_image %>" alt="<%= course.course_name %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
              <% } else { %>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-gray-400 font-medium">
                <span class="text-xs">ไม่มีรูปภาพ</span>
              </div>
              <% } %>
            </div>

            <div class="flex flex-col flex-1 p-5 justify-between gap-4">
              <div>
                <div class="mb-2.5">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold tracking-wide bg-green-50 text-green-700 border border-green-200">
                    เผยแพร่แล้ว
                  </span>
                </div>
                <h2 class="text-lg font-bold text-gray-900 line-clamp-2">
                  <%= course.course_name %>
                </h2>
              </div>

              <div class="flex flex-col sm:flex-row justify-start sm:justify-between items-start sm:items-center mt-auto pt-2 gap-3">
                <span class="text-xs text-gray-400 font-medium hidden sm:block">* ไม่สามารถแก้ไขได้</span>
                <a href="/courses/<%= course.course_id %>" class="w-full sm:w-auto text-center px-4 py-2 bg-white border border-gray-200 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 hover:text-black hover:border-gray-300 transition shadow-sm">
                  ดูหน้าคอร์สเรียน
                </a>
              </div>
            </div>

          </div>
          <% }) %>

        </div>
      </div>
      <% } %>

      <% if (publishedCourses.length > 0) { %>
      <div>
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-green-500"></span>
          เผยแพร่แล้ว (<%= publishedCourses.length %>)
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

          <% publishedCourses.forEach(course => { %>
          <div class="group border border-gray-200 overflow-hidden hover:shadow-md hover:border-gray-300 transition duration-300 bg-white flex flex-col sm:flex-row rounded-xl h-full">

            <div class="w-full sm:w-48 shrink-0 h-48 sm:h-auto relative bg-gray-100 border-b sm:border-b-0 sm:border-r border-gray-100 overflow-hidden">
              <% if (course.course_image) { %>
              <img src="<%= course.course_image %>" alt="<%= course.course_name %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
              <% } else { %>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-gray-400 font-medium">
                <span class="text-xs">ไม่มีรูปภาพ</span>
              </div>
              <% } %>
            </div>

            <div class="flex flex-col flex-1 p-5 justify-between gap-4">
              <div>
                <div class="mb-2.5">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold tracking-wide bg-green-50 text-green-700 border border-green-200">
                    เผยแพร่แล้ว
                  </span>
                </div>
                <h2 class="text-lg font-bold text-gray-900 line-clamp-2">
                  <%= course.course_name %>
                </h2>
              </div>

              <div class="flex flex-col sm:flex-row justify-start sm:justify-between items-start sm:items-center mt-auto pt-2 gap-3">
                <span class="text-xs text-gray-400 font-medium hidden sm:block">* ไม่สามารถแก้ไขได้</span>
                <a href="/courses/<%= course.course_id %>" class="w-full sm:w-auto text-center px-4 py-2 bg-white border border-gray-200 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 hover:text-black hover:border-gray-300 transition shadow-sm">
                  ดูหน้าคอร์สเรียน
                </a>
              </div>
            </div>

          </div>
          <% }) %>

        </div>
      </div>
      <% } %>

      <% if (draftCourses.length > 0) { %>
      <div>
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-gray-400"></span>
          ฉบับร่าง (<%= draftCourses.length %>)
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

          <% draftCourses.forEach(course => { %>
          <div class="group border border-gray-200 overflow-hidden hover:shadow-md hover:border-gray-300 transition duration-300 bg-white flex flex-col sm:flex-row rounded-xl h-full opacity-90 hover:opacity-100">

            <div class="w-full sm:w-48 shrink-0 h-48 sm:h-auto relative bg-gray-100 border-b sm:border-b-0 sm:border-r border-gray-100 overflow-hidden grayscale-[50%] group-hover:grayscale-0 transition-all duration-300">
              <% if (course.course_image) { %>
              <img src="<%= course.course_image %>" alt="<%= course.course_name %>" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
              <% } else { %>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-gray-400 font-medium">
                <span class="text-xs">ไม่มีรูปภาพ</span>
              </div>
              <% } %>
            </div>

            <div class="flex flex-col flex-1 p-5 justify-between gap-4">
              <div>
                <div class="mb-2.5">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold tracking-wide bg-gray-100 text-gray-600 border border-gray-200">
                    ฉบับร่าง
                  </span>
                </div>
                <h2 class="text-lg font-bold text-gray-900 line-clamp-2">
                  <%= course.course_name %>
                </h2>
              </div>

              <div class="flex justify-start sm:justify-end mt-auto pt-2">
                <a href="/instructor/courses/<%= course.course_id %>/edit" class="w-full sm:w-auto text-center px-4 py-2 bg-black border border-black text-white text-sm font-medium rounded-lg hover:bg-gray-800 transition shadow-sm">
                  แก้ไขคอร์ส
                </a>
              </div>
            </div>

          </div>
          <% }) %>

        </div>
      </div>
      <% } %>

    </div>

    <% } %>

  </div>
</section>