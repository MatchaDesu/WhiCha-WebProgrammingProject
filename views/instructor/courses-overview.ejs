<section id="content">
  <div class="container mx-auto px-6 py-12 flex flex-col gap-8">

    <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-6 pb-6 border-b border-gray-300">
      <div>
        <h1 class="text-3xl md:text-4xl leading-tight font-semibold">
          จัดการคอร์สเรียน
        </h1>
        <p class="text-gray-600 mt-2 md:text-lg">
          คอร์สทั้งหมดที่คุณสร้างขึ้นและพร้อมสอน
        </p>
      </div>

      <a href="/instructor/create-course" class="w-full md:w-auto px-8 py-3 bg-secondary text-white hover:opacity-80 transition shadow-md font-semibold text-center shrink-0 rounded-lg">
        + สร้างคอร์สใหม่
      </a>
    </div>

    <% if (!courses || courses.length===0) { %>

    <div class="flex flex-col items-center justify-center py-20 px-4 border-2 border-dashed border-gray-300 bg-gray-50 rounded-lg">
      <h2 class="text-2xl font-semibold mb-2 text-center">
        ยังไม่มีคอร์สเรียน
      </h2>
      <p class="text-gray-500 mb-8 text-center max-w-sm">
        คุณยังไม่ได้สร้างคอร์สใดๆ เริ่มต้นแบ่งปันความรู้ของคุณโดยการสร้างคอร์สแรกเลยตอนนี้
      </p>
      <a href="/instructor/create-course" class="w-full sm:w-auto px-8 py-3 bg-black text-white hover:opacity-80 transition font-semibold shadow-md rounded-lg text-center">
        สร้างคอร์สแรกของคุณ
      </a>
    </div>

    <% } else { %>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 py-4">

      <% courses.forEach(course=> { %>
      <div class="w-full border border-gray-200 overflow-hidden hover:shadow-lg transition bg-white flex flex-col sm:flex-row h-full rounded-lg">

        <div class="w-full sm:w-48 shrink-0 aspect-video sm:aspect-auto relative bg-gray-200">
          <% if (course.course_image) { %>
          <img src="<%= course.course_image %>" alt="<%= course.course_name %>" class="absolute inset-0 w-full h-full object-cover">
          <% } else { %>
          <div class="absolute inset-0 flex items-center justify-center text-gray-500 font-semibold">
            <span class="text-sm">ไม่มีรูปภาพ</span>
          </div>
          <% } %>
        </div>

        <div class="flex flex-col p-5 gap-3 flex-1 justify-center">
          <h2 class="text-xl font-semibold text-gray-800 line-clamp-2">
            <%= course.course_name %>
          </h2>
        </div>

        <div class="flex px-5 pb-5 sm:p-6 justify-start sm:justify-center items-center">
          <a href="/instructor/courses/<%= course.course_id %>/edit" class="w-full sm:w-auto text-center text-white bg-secondary px-4 py-2 rounded-md whitespace-nowrap">
            ดูรายละเอียด
          </a>
        </div>

      </div>
      <% }) %>

    </div>

    <% } %>

  </div>
</section>