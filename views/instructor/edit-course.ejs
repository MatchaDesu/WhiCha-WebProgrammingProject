<!-- Toast UI CSS -->
<link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css" />

<div class="h-14 bg-white border-b flex items-center px-6 text-sm text-gray-600">
  Instructor Panel / Course Editor
</div>

<div class="flex h-screen overflow-hidden">

  <!-- ================= SIDEBAR ================= -->
  <div class="w-1/3 border-r px-6 py-10 overflow-y-auto">

    <!-- ===== COURSE HEADER ===== -->
    <div class="mb-12">

      <div class="flex justify-between items-start">

        <div>
          <h1 class="text-2xl font-semibold">
            <%= course.course_name %>
          </h1>

          <p class="text-sm mt-2
            <%= course.course_status === 'published'
                ? 'text-green-600'
                : 'text-yellow-500' %>">
            ● <%= course.course_status %>
          </p>
        </div>

        <div class="flex flex-col items-end gap-3">

          <% if (course.course_status !=='published' ) { %>
            <form action="/instructor/courses/<%= course.course_id %>/publish" method="POST">
              <button class="px-4 py-2 bg-black text-white text-sm hover:opacity-80 transition">
                Publish
              </button>
            </form>
            <% } %>

              <button class="text-sm underline hover:opacity-70" onclick="toggleModal('new_module')">
                เพิ่ม Module
              </button>

        </div>

      </div>

    </div>

    <!-- ================= NEW MODULE MODAL ================= -->
    <div id="new_module" class="fixed inset-0 bg-black/40 hidden items-center justify-center z-50">

      <div class="bg-white w-full max-w-md p-8">

        <h2 class="text-2xl font-semibold mb-6">
          เพิ่ม Module ใหม่
        </h2>

        <form action="/instructor/courses/<%= course.course_id %>/modules/create" method="POST"
          class="flex flex-col gap-6">

          <input type="text" name="module_name" placeholder="ชื่อ Module" required
            class="w-full border px-4 py-3 focus:outline-none focus:border-black">

          <div class="flex justify-end gap-4 pt-4">

            <button type="button" onclick="toggleModal('new_module')" class="text-gray-500 hover:opacity-70">
              ยกเลิก
            </button>

            <button class="px-6 py-2 bg-black text-white hover:opacity-80 transition">
              สร้าง Module
            </button>

          </div>
        </form>

      </div>
    </div>

    <% if (!modules || modules.length===0) { %>
      <p class="text-gray-400 text-sm">ยังไม่มี Module</p>
      <% } %>

        <!-- ================= MODULE LIST ================= -->
        <% modules.forEach((module, index)=> { %>

          <div class="mb-10 border">

            <!-- MODULE HEADER -->
            <div class="flex justify-between items-center px-4 py-4 border-b">

              <div>
                <p class="text-xs text-gray-400 uppercase tracking-wide">
                  Chapter <%= index + 1 %>
                </p>
                <p class="text-lg font-semibold">
                  <%= module.module_name %>
                </p>
              </div>

              <form action="/instructor/courses/<%= course.course_id %>/modules/<%= module.module_id %>/delete"
                method="POST">
                <button class="text-red-500 text-sm hover:opacity-70">
                  ลบ
                </button>
              </form>

            </div>

            <!-- MODULE CONTENT -->
            <div class="px-4 py-4">

              <!-- ADD BUTTONS -->
              <div class="flex gap-6 mb-4 text-sm">

                <form
                  action="/instructor/courses/<%= course.course_id %>/modules/<%= module.module_id %>/lessons/create"
                  method="POST">
                  <button class="hover:underline">
                    + Lesson
                  </button>
                </form>

                <form
                  action="/instructor/courses/<%= course.course_id %>/modules/<%= module.module_id %>/quizzes/create"
                  method="POST">
                  <button class="hover:underline">
                    + Quiz
                  </button>
                </form>

              </div>

              <!-- ITEMS -->
              <% if (module.items && module.items.length> 0) { %>

                <% module.items.forEach(item=> { %>

                  <a href="/instructor/courses/<%= course.course_id %>/edit/<%= item.type %>/<%= item.data.lesson_id || item.data.quiz_id %>"
                    class="block mb-3 border px-4 py-3 text-sm font-medium
             <%= item.type === 'lesson' 
                ? 'hover:bg-gray-50'
                : 'hover:bg-gray-50' %>">

                    <%= item.type==='lesson' ? '📘' : '📝' %>
                      <%= item.type==='lesson' ? item.data.lesson_name : item.data.title %>

                  </a>

                  <% }) %>

                    <% } %>

            </div>

          </div>

          <% }) %>

  </div>

  <!-- ================= RIGHT CONTENT ================= -->
  <div class="w-2/3 from-gray-100 to-gray-50 flex flex-col h-full overflow-hidden">

    <% if (!currentItem) { %>

      <div class="flex items-center justify-center h-full text-gray-400">
        <h2 class="text-2xl">
          เลือก Lesson หรือ Quiz จากด้านซ้าย 👈
        </h2>
      </div>

      <% } else if (currentItem.type==="lesson" ) { %>

        <form id="lessonForm"
          action="/instructor/courses/<%= course.course_id %>/lessons/<%= currentItem.data.lesson_id %>/update"
          method="POST" class="flex flex-col h-full">

          <!-- ===== TOP BAR ===== -->
          <div class="bg-white shadow-sm px-10 py-6 flex justify-between items-center z-10">

            <div>
              <p class="text-xs uppercase tracking-wide text-gray-400">
                Lesson Editor
              </p>

              <input type="text" name="lesson_name" value="<%= currentItem.data.lesson_name %>"
                class="text-2xl font-semibold mt-1 focus:outline-none">
            </div>

            <div class="flex gap-4">
              <a href="/courses/<%= course.course_id %>" class="px-5 py-2 border text-sm hover:bg-gray-100 transition">
                Preview
              </a>

              <button class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm rounded-lg shadow-sm transition">
                Save Changes
              </button>
            </div>

          </div>

          <input type="hidden" name="content" id="contentInput">

          <!-- ===== EDITOR SECTION ===== -->
          <div class="flex-1 p-10 overflow-hidden">

            <div class="bg-white rounded-xl shadow-sm h-full flex flex-col">

              <div class="border-b px-6 py-3 text-sm text-gray-500">
                Markdown Content
              </div>

              <div class="flex-1 overflow-y-auto">
                <div id="editor" class="h-full" data-content="<%- currentItem.data.content || '' %>">
                </div>
              </div>

            </div>

          </div>

        </form>

        <% } else if (currentItem.type==="quiz" ) { %>

          <!-- ===== QUIZ VIEW ===== -->
          <div class="flex-1 overflow-y-auto p-10">

            <div class="bg-white border p-10">

              <div class="flex justify-between items-start mb-8">

                <div>
                  <p class="text-xs uppercase tracking-wide text-gray-400">
                    Quiz
                  </p>
                  <h2 class="text-2xl font-semibold mt-1">
                    <%= currentItem.data.title %>
                  </h2>
                </div>

                <button class="px-6 py-2 bg-black text-white text-sm hover:opacity-80 transition">
                  Edit Quiz
                </button>

              </div>

              <div class="prose max-w-none text-gray-700">
                <%= currentItem.data.description %>
              </div>

            </div>

          </div>

          <% } %>

  </div>

</div>

<!-- Toast UI JS -->
<script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>

<script>
  function toggleModal(id) {
    const el = document.getElementById(id);
    if (el.classList.contains("hidden")) {
      el.classList.remove("hidden");
      el.classList.add("flex");
    } else {
      el.classList.add("hidden");
      el.classList.remove("flex");
    }
  }

  document.addEventListener("DOMContentLoaded", function () {

    const editorEl = document.getElementById("editor");
    const lessonForm = document.getElementById("lessonForm");

    if (editorEl && lessonForm) {

      const editor = new toastui.Editor({
        el: editorEl,
        height: '100%',
        initialEditType: 'markdown',
        previewStyle: 'vertical',
        initialValue: editorEl.dataset.content || ''
      });

      lessonForm.addEventListener("submit", function () {
        document.getElementById("contentInput").value = editor.getMarkdown();
      });

    }

  });
</script>