<%= course.course_name %>
<%= course.description %>
<%= course.instructor_name %>
<%= course.instructor_profile %>
<%= course.course_image %>
<%= course.course_price %>
<%= course.publish_date %>
<%= course.created_at %>

<% if (!isEnrolled) {%>
    <form action="/courses/<%= course.course_id %>/enroll" method="POST">
        <button type="submit">Enroll</button>
    </form>
<% } else { %>
    <a href="/courses/<%= course.course_id %>/learn">
        <button>Go to Learn</button>
    </a>
<% } %>