<section class="bg-gray-50 min-h-screen pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

    <!-- Back -->
    <div class="mb-6">
      <a href="/courses" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-black transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        กลับไปหน้าคอร์สทั้งหมด
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- ── Left ── -->
      <div class="lg:col-span-2 flex flex-col gap-6">

        <!-- Cover -->
        <div class="w-full aspect-video rounded-xl overflow-hidden bg-gray-100 border border-gray-200 shadow-sm">
          <% if (course.course_image) { %>
            <img src="<%= course.course_image %>" class="w-full h-full object-cover" alt="<%= course.course_name %>">
          <% } else { %>
            <div class="w-full h-full flex items-center justify-center text-gray-300 flex-col gap-2">
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <span class="text-sm">ไม่มีรูปภาพ</span>
            </div>
          <% } %>
        </div>

        <!-- Title & Meta -->
        <div>
          <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 leading-tight mb-3">
            <%= course.course_name %>
          </h1>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gray-500">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <%= typeof student_count !== 'undefined' ? student_count : 0 %> ผู้เรียน
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              อัปเดต <%= (course.publish_date || course.created_at)
                ? new Date((course.publish_date || course.created_at).replace(' ','T')).toLocaleDateString('th-TH')
                : '-' %>
            </span>
          </div>
        </div>

        <!-- Description -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
          <h2 class="text-sm font-bold text-gray-700 uppercase tracking-widest mb-3">รายละเอียดคอร์ส</h2>
          <p class="text-sm text-gray-600 leading-relaxed whitespace-pre-line">
            <%= course.description || 'ไม่มีคำอธิบาย' %>
          </p>
        </div>

        <!-- Curriculum -->
        <% if (typeof modules !== 'undefined' && modules && modules.length > 0) { %>
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100">
              <h2 class="text-sm font-bold text-gray-700 uppercase tracking-widest">เนื้อหาคอร์ส</h2>
            </div>
            <div class="divide-y divide-gray-100">
              <% modules.forEach((mod, mIdx) => { %>
                <div>
                  <button onclick="toggleModule(<%= mIdx %>)"
                    class="w-full flex items-center justify-between px-6 py-4 hover:bg-gray-50 transition text-left">
                    <div class="flex items-center gap-3">
                      <span class="w-6 h-6 rounded-full bg-gray-100 text-gray-600 text-xs font-bold flex items-center justify-center shrink-0">
                        <%= mIdx + 1 %>
                      </span>
                      <span class="font-semibold text-gray-900 text-sm"><%= mod.module_name %></span>
                      <span class="text-xs text-gray-400"><%= mod.items ? mod.items.length : 0 %> รายการ</span>
                    </div>
                    <svg id="chevron-<%= mIdx %>" class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </button>

                  <div id="module-<%= mIdx %>" class="border-t border-gray-100 divide-y divide-gray-50">
                    <% if (mod.items && mod.items.length > 0) { %>
                      <% mod.items.forEach(item => { %>
                        <div class="flex items-center gap-3 px-6 py-3 bg-gray-50/50 pl-14">
                          <% if (item.type === 'lesson') { %>
                            <div class="p-1.5 bg-orange-100 text-orange-500 rounded shrink-0">
                              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"></path>
                              </svg>
                            </div>
                            <span class="text-xs text-gray-700 flex-1"><%= item.data.lesson_name %></span>
                            <span class="text-[10px] font-bold text-orange-600 bg-orange-50 px-2 py-0.5 rounded border border-orange-200">Lesson</span>
                          <% } else { %>
                            <div class="p-1.5 bg-purple-100 text-purple-500 rounded shrink-0">
                              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                              </svg>
                            </div>
                            <span class="text-xs text-gray-700 flex-1"><%= item.data.title %></span>
                            <span class="text-[10px] font-bold text-purple-600 bg-purple-50 px-2 py-0.5 rounded border border-purple-200">
                              Quiz · <%= item.data.questions ? item.data.questions.length : 0 %> ข้อ
                            </span>
                          <% } %>
                        </div>
                      <% }) %>
                    <% } else { %>
                      <p class="px-14 py-3 text-xs text-gray-400 bg-gray-50/50">ไม่มีรายการ</p>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Instructor -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 flex items-center gap-4">
          <div class="w-14 h-14 rounded-full overflow-hidden bg-gray-100 shrink-0 border border-gray-200">
            <img src="<%= course.instructor_profile || '/icon/profile-anonymous.svg' %>" class="w-full h-full object-cover">
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-orange-500 mb-0.5">ผู้สอน</p>
            <h3 class="text-sm font-bold text-gray-900"><%= course.instructor_name || 'ไม่ระบุ' %></h3>
          </div>
        </div>

      </div>

      <!-- ── Right: Enrollment Card ── -->
      <div class="lg:col-span-1">
        <div class="bg-white border border-gray-200 rounded-xl shadow-md p-5 sticky top-6 flex flex-col gap-5">

          <!-- Price -->
          <div>
            <% if (course.course_price == 0) { %>
              <p class="text-4xl font-extrabold text-gray-900">ฟรี</p>
            <% } else { %>
              <p class="text-4xl font-extrabold text-gray-900">฿<%= course.course_price %></p>
            <% } %>
          </div>

          <!-- CTA -->
          <% if (!isEnrolled) { %>
            <form action="/courses/<%= course.course_id %>/enroll" method="POST">
              <button type="submit"
                class="w-full py-3 bg-black text-white rounded-lg text-sm font-bold hover:bg-gray-800 transition shadow-sm">
                ลงทะเบียนเรียน
              </button>
            </form>
          <% } else { %>
            <a href="/courses/<%= course.course_id %>/learn"
              class="block w-full py-3 bg-orange-500 text-white text-center rounded-lg text-sm font-bold hover:bg-orange-600 transition shadow-sm">
              ไปที่คอร์สเรียน →
            </a>
          <% } %>

          <!-- Stats -->
          <% if (typeof stats !== 'undefined') { %>
            <div class="grid grid-cols-3 gap-2 border-t border-gray-100 pt-4">
              <div class="bg-gray-50 rounded-lg p-2.5 text-center border border-gray-100">
                <p class="text-lg font-bold text-gray-900"><%= stats.moduleCount %></p>
                <p class="text-[9px] text-gray-400 mt-0.5">Modules</p>
              </div>
              <div class="bg-gray-50 rounded-lg p-2.5 text-center border border-gray-100">
                <p class="text-lg font-bold text-gray-900"><%= stats.lessonCount %></p>
                <p class="text-[9px] text-gray-400 mt-0.5">Lessons</p>
              </div>
              <div class="bg-gray-50 rounded-lg p-2.5 text-center border border-gray-100">
                <p class="text-lg font-bold text-gray-900"><%= stats.quizCount %></p>
                <p class="text-[9px] text-gray-400 mt-0.5">Quizzes</p>
              </div>
            </div>
          <% } %>

          <!-- Perks -->
          <div class="flex flex-col gap-2.5 text-xs text-gray-500 border-t border-gray-100 pt-4">
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              เรียนได้ทุกที่ ทุกเวลา
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              เรียนได้ตามสะดวก
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function toggleModule(idx) {
    const content  = document.getElementById(`module-${idx}`);
    const chevron  = document.getElementById(`chevron-${idx}`);
    const isHidden = content.style.display === 'none';
    content.style.display   = isHidden ? '' : 'none';
    chevron.style.transform = isHidden ? 'rotate(180deg)' : '';
  }
</script>
