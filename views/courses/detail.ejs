<section id="course-details">
    <div class="container mx-auto flex flex-col md:flex-row px-6 py-12 gap-8">

        <div class="flex w-full md:w-1/2">
            <div class="w-full h-64 md:h-full rounded-lg overflow-hidden border border-gray-200">
                <% if (course.course_image) { %>
                    <img src="<%= course.course_image %>" class="w-full h-full object-cover" alt="<%= course.course_name %>">
                <% } else { %>
                    <div class="w-full h-full bg-gray-200 flex items-center justify-center text-gray-500 text-6xl font-bold uppercase">
                        <%= course.course_name.charAt(0) %>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="flex flex-col w-full md:w-1/2 justify-center py-4">

            <div class="flex flex-col gap-4">
                
                <h1 class="text-3xl font-semibold text-center md:text-4xl md:text-left">
                    <%= course.course_name %>
                </h1>

                <div class="flex items-center justify-center md:justify-start gap-4 mt-2">
                    <% if (course.instructor_profile) { %>
                        <img src="<%= course.instructor_profile || '/icon/profile-anonymous.svg' %>" class="w-12 h-12 rounded-full object-cover border border-gray-200">
                    <% } else { %>
                        <div class="w-12 h-12 rounded-full bg-gray-300"></div>
                    <% } %>
                    <div class="text-left">
                        <p class="text-sm text-gray-500">ผู้สอน</p>
                        <p class="font-semibold text-gray-800">
                            <%= course.instructor_name %>
                        </p>
                    </div>
                </div>

                <p class="text-center text-gray-700 md:text-lg md:text-left mt-4 leading-relaxed">
                    <%= course.description %>
                </p>

                <div class="flex flex-row justify-center md:justify-start gap-8 text-sm text-gray-500 mt-4">
                    <div class="text-center md:text-left">
                        <p class="font-medium text-gray-700">วันที่สร้าง</p>
                        <p><%= course.created_at %></p>
                    </div>
                    <% if (course.publish_date) { %>
                    <div class="text-center md:text-left">
                        <p class="font-medium text-gray-700">วันที่เผยแพร่</p>
                        <p><%= course.publish_date %></p>
                    </div>
                    <% } %>
                </div>

            </div>

            <div class="flex flex-col md:flex-row items-center justify-between border-t border-gray-300 mt-8 pt-8 gap-6">

                <div>
                    <% if (course.course_price == 0) { %>
                        <p class="text-3xl font-bold text-green-600">
                            ฟรี
                        </p>
                    <% } else { %>
                        <p class="text-3xl font-bold text-gray-900">
                            ฿<%= course.course_price %>
                        </p>
                    <% } %>
                </div>

                <div class="w-full md:w-auto">
                    <% if (!isEnrolled) { %>
                        <form action="/courses/<%= course.course_id %>/enroll" method="POST">
                            <button class="px-8 py-3 bg-black text-white text-lg font-semibold rounded-lg hover:bg-gray-800 transition w-full md:w-auto">
                                สมัครเรียน
                            </button>
                        </form>
                    <% } else { %>
                        <a href="/courses/<%= course.course_id %>/dashboard" class="block w-full md:w-auto">
                            <button class="px-8 py-3 bg-black text-white text-lg font-semibold rounded-lg hover:bg-gray-800 transition w-full">
                                เข้าสู่บทเรียน
                            </button>
                        </a>
                    <% } %>
                </div>

            </div>

        </div>

    </div>
</section>

<div class="w-12 h-0.5 bg-gray-400 mx-auto mt-4 mb-8"></div>