<section class="bg-gray-50 min-h-screen pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

    <!-- Back -->
    <div class="mb-6">
      <a href="/courses" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-black transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        กลับไปหน้าคอร์สทั้งหมด
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- ── Left ── -->
      <div class="lg:col-span-2 flex flex-col gap-6">

        <!-- Cover -->
        <div class="w-full aspect-video rounded-xl overflow-hidden bg-gray-100 border border-gray-200 shadow-sm">
          <% if (course.course_image) { %>
          <img src="<%= course.course_image %>" class="w-full h-full object-cover" alt="<%= course.course_name %>">
          <% } %>
        </div>

        <!-- Title & Meta -->
        <div>
          <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 leading-tight mb-3">
            <%= course.course_name %>
          </h1>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-gray-500">
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <%= typeof student_count !== 'undefined' ? student_count : 0 %> ผู้เรียน
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              อัปเดต <%= (course.publish_date || course.created_at) %>
            </span>
          </div>
        </div>

        <!-- Description -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
          <h2 class="text-sm font-bold text-gray-700 uppercase tracking-widest mb-3">รายละเอียดคอร์ส</h2>
          <p class="text-sm text-gray-600 leading-relaxed whitespace-pre-line">
            <%= course.description || 'ไม่มีคำอธิบาย' %>
          </p>
        </div>

        <!-- Curriculum -->
        <% if (typeof modules !== 'undefined' && modules && modules.length > 0) { %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100">
            <h2 class="text-sm font-bold text-gray-700 uppercase tracking-widest">เนื้อหาคอร์ส</h2>
          </div>
          <div class="divide-y divide-gray-100">
            <% modules.forEach((mod, mIdx) => { %>
            <div>
              <div class="w-full flex items-center justify-between px-6 py-4 hover:bg-gray-50 transition text-left">
                <div class="flex items-center gap-3">
                  <span class="w-6 h-6 rounded-full bg-gray-100 text-gray-600 text-xs font-bold flex items-center justify-center shrink-0">
                    <%= mIdx + 1 %>
                  </span>
                  <span class="font-semibold text-gray-900 text-sm"><%= mod.module_name %></span>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- Instructor -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 flex items-center gap-4">
          <div class="w-14 h-14 rounded-full overflow-hidden bg-gray-100 shrink-0 border border-gray-200">
            <img src="<%= course.instructor_profile || '/icon/profile-anonymous.svg' %>" class="w-full h-full object-cover">
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-orange-500 mb-0.5">ผู้สอน</p>
            <h3 class="text-sm font-bold text-gray-900"><%= course.instructor_name || 'ไม่ระบุ' %></h3>
          </div>
        </div>

      </div>

      <!-- ── Right: Enrollment Card ── -->
      <div class="lg:col-span-1">
        <div class="bg-white border border-gray-200 rounded-xl shadow-md p-5 sticky top-24 flex flex-col gap-5">

          <!-- Price -->
          <div>
            <% if (course.course_price == 0) { %>
            <p class="text-4xl font-extrabold text-gray-900">ฟรี</p>
            <% } else { %>
            <p class="text-4xl font-extrabold text-gray-900">฿<%= course.course_price %></p>
            <% } %>
          </div>

          <!-- CTA -->
          <% if (!isEnrolled) { %>
          <a href="/courses/<%= course.course_id %>/checkout"
            class="block w-full py-3 bg-black text-white text-center rounded-lg text-sm font-bold hover:bg-gray-800 transition shadow-sm">
            ลงทะเบียนเรียน
          </a>
          <% } else { %>
          <a href="/courses/<%= course.course_id %>/dashboard" class="block w-full py-3 bg-orange-500 text-white text-center rounded-lg text-sm font-bold hover:bg-orange-600 transition shadow-sm">
            ไปที่คอร์สเรียน →
          </a>
          <% } %>

          <!-- Stats -->
          <% if (typeof stats !== 'undefined') { %>
          <div class="grid grid-cols-3 gap-2 border-t border-gray-100 pt-4">
            <div class="bg-gray-50 rounded-lg p-2.5 text-center border border-gray-100">
              <p class="text-lg font-bold text-gray-900"><%= stats.moduleCount %></p>
              <p class="text-[9px] text-gray-400 mt-0.5">Modules</p>
            </div>
            <div class="bg-gray-50 rounded-lg p-2.5 text-center border border-gray-100">
              <p class="text-lg font-bold text-gray-900"><%= stats.lessonCount %></p>
              <p class="text-[9px] text-gray-400 mt-0.5">Lessons</p>
            </div>
            <div class="bg-gray-50 rounded-lg p-2.5 text-center border border-gray-100">
              <p class="text-lg font-bold text-gray-900"><%= stats.quizCount %></p>
              <p class="text-[9px] text-gray-400 mt-0.5">Quizzes</p>
            </div>
          </div>
          <% } %>

          <!-- Perks -->
          <div class="flex flex-col gap-2.5 text-xs text-gray-500 border-t border-gray-100 pt-4">
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              เรียนได้ทุกที่ ทุกเวลา
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              เรียนได้ตามสะดวก
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         Reviews Section  (Steam-style)
    ══════════════════════════════════════ -->
    <div class="mt-10">

      <!-- Header + Overall Summary -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
        <h2 class="text-base font-bold text-gray-800 uppercase tracking-widest">รีวิวจากผู้เรียน</h2>
        <% if (typeof reviewSummary !== 'undefined' && reviewSummary && reviewSummary.total > 0) {
            const pct = reviewSummary.recommend_pct;
            let label, lc, bc;
            if (pct >= 80)      { label='แนะนำเป็นอย่างยิ่ง'; lc='text-green-700'; bc='bg-green-50 border-green-200'; }
            else if (pct >= 60) { label='แนะนำ';              lc='text-green-600'; bc='bg-green-50 border-green-200'; }
            else if (pct >= 40) { label='ปนเปกัน';            lc='text-yellow-600'; bc='bg-yellow-50 border-yellow-200'; }
            else                { label='ไม่แนะนำ';           lc='text-red-600';   bc='bg-red-50 border-red-200'; }
        %>
        <div class="flex items-center gap-2 px-3 py-2 rounded-lg border <%= bc %>">
          <svg class="w-4 h-4 <%= lc %>" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z" />
          </svg>
          <span class="text-sm font-bold <%= lc %>"><%= label %></span>
          <span class="text-xs text-gray-400">(<%= pct %>% จาก <%= reviewSummary.total %> รีวิว)</span>
        </div>
        <% } %>
      </div>

      <!-- ── Write Review (enrolled + ยังไม่เคยรีวิว) ── -->
      <% if (isEnrolled && !userReview) { %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 mb-6">
        <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4">รีวิวคอร์สนี้</p>
        <form action="/courses/<%= course.course_id %>/reviews" method="POST">

          <div class="flex items-center gap-3 mb-4">
            <p class="text-sm text-gray-600">คุณแนะนำคอร์สนี้หรือไม่?</p>
            <div class="flex gap-2">
              <button type="button" id="btn-up" onclick="setThumb(1)" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200 text-gray-400 text-xs font-bold hover:border-green-400 hover:text-green-600 hover:bg-green-50 transition">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z" />
                </svg>
                แนะนำ
              </button>
              <button type="button" id="btn-down" onclick="setThumb(0)" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200 text-gray-400 text-xs font-bold hover:border-red-400 hover:text-red-500 hover:bg-red-50 transition">
                <svg class="w-4 h-4 rotate-180" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z" />
                </svg>
                ไม่แนะนำ
              </button>
            </div>
          </div>
          <input type="hidden" name="is_recommended" id="thumb-input" required>

          <textarea name="comment" rows="3" placeholder="แชร์ประสบการณ์ของคุณกับผู้เรียนคนอื่น..." class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 resize-none focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-400 transition mb-3" required></textarea>

          <div class="flex justify-end">
            <button type="submit" id="submit-review" disabled class="px-5 py-2 bg-gray-200 text-gray-400 text-sm font-bold rounded-lg cursor-not-allowed transition" title="กรุณาเลือก แนะนำ หรือ ไม่แนะนำ ก่อน">
              โพสต์รีวิว
            </button>
          </div>
        </form>
      </div>
      <% } %>

      <!-- ── Review List ── -->
      <% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
      <div class="flex flex-col gap-3">

        <!-- รีวิวของตัวเอง (อยู่บนสุด + มีปุ่มแก้ไข) -->
        <% if (isEnrolled && userReview) { %>
        <div class="bg-orange-50 border border-orange-200 rounded-xl p-5 flex gap-3">
          <div class="w-9 h-9 rounded-full overflow-hidden bg-gray-100 border border-gray-200 shrink-0">
            <img src="<%= userReview.profile_image %>" class="w-full h-full object-cover">
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-2 mb-2">
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-gray-800"><%= userReview.reviewer_name %></span>
                <span class="text-[10px] font-bold text-orange-500 bg-orange-100 px-1.5 py-0.5 rounded">รีวิวของคุณ</span>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-[10px] text-gray-400">
                  <%= new Date(userReview.created_at.replace(' ','T')).toLocaleDateString('th-TH',{year:'numeric',month:'short',day:'numeric'}) %>
                </span>
                <button onclick="openEditModal()" class="flex items-center gap-1 text-[11px] font-bold text-gray-500 hover:text-black border border-gray-200 hover:border-gray-400 rounded-lg px-2 py-1 transition">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                  แก้ไข
                </button>
              </div>
            </div>

            <% if (userReview.is_recommended == 1) { %>
            <div class="flex items-center gap-1 text-green-600 text-xs font-bold mb-2">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z" />
              </svg>
              แนะนำ
            </div>
            <% } else { %>
            <div class="flex items-center gap-1 text-red-500 text-xs font-bold mb-2">
              <svg class="w-3.5 h-3.5 rotate-180" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z" />
              </svg>
              ไม่แนะนำ
            </div>
            <% } %>

            <% if (userReview.comment) { %>
            <p class="text-sm text-gray-600 leading-relaxed"><%= userReview.comment %></p>
            <% } %>
          </div>
        </div>
        <% } %>

        <!-- รีวิวของคนอื่น (กรองตัวเองออก) -->
        <% reviews.forEach(r => { if (userReview && r.user_id == userReview.user_id) return; %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 flex gap-3">
          <div class="w-9 h-9 rounded-full overflow-hidden bg-gray-100 border border-gray-200 shrink-0">
            <img src="<%= r.profile_image %>" class="w-full h-full object-cover">
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-sm font-bold text-gray-800"><%= r.reviewer_name %></span>
              <span class="text-[10px] text-gray-400 shrink-0">
                <%= new Date(r.created_at.replace(' ','T')).toLocaleDateString('th-TH',{year:'numeric',month:'short',day:'numeric'}) %>
              </span>
            </div>
            <% if (r.is_recommended == 1) { %>
            <div class="flex items-center gap-1 text-green-600 text-xs font-bold mb-2">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z" />
              </svg>
              แนะนำ
            </div>
            <% } else { %>
            <div class="flex items-center gap-1 text-red-500 text-xs font-bold mb-2">
              <svg class="w-3.5 h-3.5 rotate-180" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z" />
              </svg>
              ไม่แนะนำ
            </div>
            <% } %>
            <% if (r.comment) { %>
            <p class="text-sm text-gray-600 leading-relaxed"><%= r.comment %></p>
            <% } %>
          </div>
        </div>
        <% }) %>

      </div>
      <% } else { %>
      <div class="bg-white border border-dashed border-gray-200 rounded-xl p-10 text-center">
        <svg class="w-8 h-8 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
        </svg>
        <p class="text-sm text-gray-400">ยังไม่มีรีวิว — เป็นคนแรกที่รีวิว!</p>
      </div>
      <% } %>

    </div>
  </div>
</section>

<!-- ══════════════════════════════════════
     Edit Review Modal
══════════════════════════════════════ -->
<% if (isEnrolled && userReview) { %>
<div id="edit-modal" class="fixed inset-0 z-50 hidden">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeEditModal()"></div>

  <!-- Panel -->
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 relative">

      <!-- Header -->
      <div class="flex items-center justify-between mb-5">
        <h3 class="text-sm font-bold text-gray-800 uppercase tracking-widest">แก้ไขรีวิว</h3>
        <button onclick="closeEditModal()" class="w-7 h-7 flex items-center justify-center rounded-full text-gray-400 hover:text-black hover:bg-gray-100 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form action="/courses/<%= course.course_id %>/reviews" method="POST">

        <!-- Thumb buttons -->
        <p class="text-sm text-gray-600 mb-3">คุณแนะนำคอร์สนี้หรือไม่?</p>
        <div class="flex gap-2 mb-4">
          <button type="button" id="edit-btn-up" onclick="setEditThumb(1)" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-bold transition
                     <%= userReview.is_recommended == 1 ? 'border-green-400 text-green-600 bg-green-50' : 'border-gray-200 text-gray-400' %>
                     hover:border-green-400 hover:text-green-600 hover:bg-green-50">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z" />
            </svg>
            แนะนำ
          </button>
          <button type="button" id="edit-btn-down" onclick="setEditThumb(0)" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-bold transition
                     <%= userReview.is_recommended == 0 ? 'border-red-400 text-red-500 bg-red-50' : 'border-gray-200 text-gray-400' %>
                     hover:border-red-400 hover:text-red-500 hover:bg-red-50">
            <svg class="w-4 h-4 rotate-180" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z" />
            </svg>
            ไม่แนะนำ
          </button>
        </div>
        <input type="hidden" name="is_recommended" id="edit-thumb-input" value="<%= userReview.is_recommended %>" required>

        <textarea name="comment" id="edit-comment" rows="4" placeholder="แชร์ประสบการณ์ของคุณ..." class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 resize-none focus:outline-none focus:ring-2 focus:ring-orange-300 focus:border-orange-400 transition mb-4"><%= userReview.comment || '' %></textarea>

        <div class="flex justify-end gap-2">
          <button type="button" onclick="closeEditModal()" class="px-4 py-2 text-sm font-bold text-gray-500 hover:text-black border border-gray-200 hover:border-gray-400 rounded-lg transition">
            ยกเลิก
          </button>
          <button type="submit" class="px-5 py-2 bg-black text-white text-sm font-bold rounded-lg hover:bg-gray-800 transition">
            บันทึก
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<script>
  /* ── New review form ── */
  function setThumb(val) {
    document.getElementById('thumb-input').value = val;
    const up = document.getElementById('btn-up');
    const down = document.getElementById('btn-down');
    const submit = document.getElementById('submit-review');

    if (val === 1) {
      up.classList.add('border-green-400', 'text-green-600', 'bg-green-50');
      up.classList.remove('border-gray-200', 'text-gray-400');
      down.classList.remove('border-red-400', 'text-red-500', 'bg-red-50');
      down.classList.add('border-gray-200', 'text-gray-400');
    } else {
      down.classList.add('border-red-400', 'text-red-500', 'bg-red-50');
      down.classList.remove('border-gray-200', 'text-gray-400');
      up.classList.remove('border-green-400', 'text-green-600', 'bg-green-50');
      up.classList.add('border-gray-200', 'text-gray-400');
    }

    if (submit) {
      submit.disabled = false;
      submit.classList.remove('bg-gray-200', 'text-gray-400', 'cursor-not-allowed');
      submit.classList.add('bg-black', 'text-white', 'hover:bg-gray-800');
      submit.removeAttribute('title');
    }
  }

  /* ── Edit modal ── */
  function openEditModal() {
    document.getElementById('edit-modal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeEditModal() {
    document.getElementById('edit-modal').classList.add('hidden');
    document.body.style.overflow = '';
  }

  function setEditThumb(val) {
    document.getElementById('edit-thumb-input').value = val;
    const up = document.getElementById('edit-btn-up');
    const down = document.getElementById('edit-btn-down');

    if (val === 1) {
      up.classList.add('border-green-400', 'text-green-600', 'bg-green-50');
      up.classList.remove('border-gray-200', 'text-gray-400');
      down.classList.remove('border-red-400', 'text-red-500', 'bg-red-50');
      down.classList.add('border-gray-200', 'text-gray-400');
    } else {
      down.classList.add('border-red-400', 'text-red-500', 'bg-red-50');
      down.classList.remove('border-gray-200', 'text-gray-400');
      up.classList.remove('border-green-400', 'text-green-600', 'bg-green-50');
      up.classList.add('border-gray-200', 'text-gray-400');
    }
  }
</script>