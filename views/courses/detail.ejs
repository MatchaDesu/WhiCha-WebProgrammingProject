<section class="bg-gray-50 min-h-screen pb-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 flex flex-col lg:flex-row gap-8 lg:gap-12 items-start">

    <!-- LEFT: Main Content -->
    <div class="flex-1 min-w-0 flex flex-col gap-8">

      <!-- Course Thumbnail -->
      <div class="w-full aspect-video rounded-xl overflow-hidden border border-gray-200 bg-gray-100 shadow-sm">
        <% if (course.course_image) { %>
          <img src="<%= course.course_image %>" class="w-full h-full object-cover" alt="<%= course.course_name %>">
        <% } else { %>
          <div class="w-full h-full flex items-center justify-center text-gray-300 flex-col gap-2">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span class="text-sm font-medium">ไม่มีรูปภาพ</span>
          </div>
        <% } %>
      </div>

      <!-- Title & Meta -->
      <div>
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-gray-900 leading-tight mb-4">
          <%= course.course_name %>
        </h1>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-gray-500 font-medium">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <%= typeof student_count !== 'undefined' ? student_count : 0 %> ผู้เรียน
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            อัปเดต <%= course.publish_date ? new Date(course.publish_date).toLocaleDateString('th-TH') : new Date(course.created_at).toLocaleDateString('th-TH') %>
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
        <h3 class="text-lg font-bold text-gray-900 mb-3">รายละเอียดคอร์ส</h3>
        <div class="text-gray-600 text-sm leading-relaxed whitespace-pre-line">
          <%= course.description || 'ไม่มีคำอธิบาย' %>
        </div>
      </div>

      <!-- Curriculum -->
      <% if (typeof modules !== 'undefined' && modules && modules.length > 0) { %>
        <div>
          <h3 class="text-lg font-bold text-gray-900 mb-4">เนื้อหาคอร์ส</h3>
          <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden divide-y divide-gray-100">
            <% modules.forEach(function(module, modIndex) { %>

              <!-- Module Header -->
              <div class="bg-gray-50 px-5 py-3.5 flex justify-between items-center border-b border-gray-100">
                <h4 class="font-bold text-gray-800 text-sm">
                  Section <%= modIndex + 1 %>: <%= module.module_name %>
                </h4>
                <span class="text-xs font-medium text-gray-400 shrink-0 ml-3">
                  <%= module.items ? module.items.length : 0 %> รายการ
                </span>
              </div>

              <!-- Module Items -->
              <% if (module.items && module.items.length > 0) { %>
                <div class="divide-y divide-gray-50">
                  <% module.items.forEach(function(item) { %>
                    <div class="flex items-center gap-3.5 py-3 px-5 hover:bg-gray-50 transition group">
                      <% if (item.item_type === 'lesson') { %>
                        <div class="p-1.5 bg-orange-50 rounded-md text-orange-500 shrink-0">
                          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"></path></svg>
                        </div>
                      <% } else if (item.item_type === 'quiz') { %>
                        <div class="p-1.5 bg-purple-50 rounded-md text-purple-500 shrink-0">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                        </div>
                      <% } %>
                      <span class="text-sm text-gray-700 group-hover:text-gray-900 transition">
                        <%= item.title || item.lesson_name || item.name || 'ไม่มีชื่อ' %>
                      </span>
                      <span class="ml-auto text-[10px] font-semibold px-2 py-0.5 rounded-full shrink-0
                        <%= item.item_type === 'lesson' ? 'bg-orange-50 text-orange-500' : 'bg-purple-50 text-purple-500' %>">
                        <%= item.item_type === 'lesson' ? 'Lesson' : 'Quiz' %>
                      </span>
                    </div>
                  <% }); %>
                </div>
              <% } %>

            <% }); %>
          </div>
        </div>
      <% } %>

      <!-- Instructor -->
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 flex flex-col sm:flex-row gap-5 items-center sm:items-start">
        <div class="w-20 h-20 rounded-full border border-gray-200 overflow-hidden shrink-0 bg-gray-100">
          <% if (course.instructor_profile) { %>
            <img src="<%= course.instructor_profile %>" alt="" class="w-full h-full object-cover">
          <% } else { %>
            <div class="w-full h-full flex items-center justify-center text-2xl font-bold text-white bg-gray-400 uppercase">
              <%= course.instructor_name ? course.instructor_name.charAt(0) : 'U' %>
            </div>
          <% } %>
        </div>
        <div class="text-center sm:text-left">
          <p class="text-[11px] font-bold uppercase tracking-widest text-orange-500 mb-1">ผู้สอน</p>
          <h3 class="text-lg font-bold text-gray-900"><%= course.instructor_name || 'ไม่ระบุ' %></h3>
        </div>
      </div>

    </div>

    <!-- RIGHT: Sticky Enrollment Card -->
    <div class="w-full lg:w-[340px] xl:w-[360px] shrink-0 lg:sticky lg:top-8">
      <div class="bg-white rounded-xl border border-gray-200 shadow-md p-6 flex flex-col gap-5">

        <!-- Price -->
        <div>
          <% if (course.course_price == 0) { %>
            <p class="text-4xl font-extrabold text-gray-900">ฟรี</p>
          <% } else { %>
            <p class="text-4xl font-extrabold text-gray-900">฿<%= course.course_price %></p>
          <% } %>
        </div>

        <!-- CTA Button -->
        <% if (!isEnrolled) { %>
          <form action="/courses/<%= course.course_id %>/enroll" method="POST">
            <button type="submit" class="w-full py-3.5 bg-black text-white rounded-lg text-sm font-bold hover:bg-gray-800 transition shadow-sm">
              ลงทะเบียนเรียน
            </button>
          </form>
        <% } else { %>
          <a href="/courses/<%= course.course_id %>/dashboard" class="block w-full">
            <button class="w-full py-3.5 bg-orange-500 text-white rounded-lg text-sm font-bold hover:bg-orange-600 transition shadow-sm">
              ไปที่คอร์สเรียน
            </button>
          </a>
        <% } %>

        <!-- Quick Stats -->
        <div class="border-t border-gray-100 pt-4 flex flex-col gap-3 text-sm text-gray-600">
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>
            เรียนได้ทุกที่ ทุกเวลา
          </div>
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            เรียนได้ตามสะดวก
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
