<section id="course-overview" class="bg-gray-50 min-h-screen pb-12">
  <div class="container mx-auto flex flex-col px-4 gap-4 sm:px-6 py-8">

    <div>
      <a href="/courses" class="inline-flex items-center text-gray-500 hover:text-gray-800 transition mb-4 text-sm font-medium">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        กลับหน้ารวมคอร์ส
      </a>

      <h1 class="text-2xl md:text-3xl font-bold text-gray-800 line-clamp-1">
        <%= course.course_name %>
      </h1>
    </div>
  
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">

      <a href="/courses/<%= course.course_id %>/announcement" class="bg-white rounded-lg border border-gray-200 p-6 flex flex-col sm:col-span-2 shadow-sm hover:border-gray-300 hover:shadow-md transition gap-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path></svg>
            <h2 class="text-lg font-bold text-gray-800">ประกาศจากอาจารย์</h2>
          </div>
          <span class="text-sm text-gray-400 font-medium">ดูทั้งหมด →</span>
        </div>

        <% if (latestAnnouncement) { %>
          <div class="border-t border-gray-100 pt-3">
            <p class="font-semibold text-gray-800 line-clamp-1"><%= latestAnnouncement.title %></p>
            <% if (latestAnnouncement.content) { %>
              <p class="text-sm text-gray-500 mt-1 line-clamp-2"><%= latestAnnouncement.content %></p>
            <% } %>
            <p class="text-xs text-gray-400 mt-2">
              <%= new Date(latestAnnouncement.created_at).toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' }) %>
            </p>
          </div>
        <% } else { %>
          <p class="text-sm text-gray-400 italic border-t border-gray-100 pt-3">ยังไม่มีประกาศในขณะนี้</p>
        <% } %>
      </a>
      
      <a href="/courses/<%= course.course_id %>/learn" class="bg-white rounded-lg border border-gray-200 p-6 flex items-center justify-between shadow-sm hover:border-gray-300 hover:shadow-md transition">
        <div>
          <p class="text-sm font-medium text-gray-500">จำนวนบทเรียน</p>
          <div class="flex items-baseline gap-1">
            <h3 class="text-3xl font-bold text-gray-800"><%= stats.moduleCount || 0 %></h3>
            <span class="text-sm font-medium text-gray-500">บทเรียน</span>
          </div>
        </div>
        <div class="p-3  text-secondary rounded-lg">
          <svg class="w-6 h-6" fill="none" stroke="green" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
        </div>
      </a>

      <a href="/courses/<%= course.course_id %>/students" class="bg-white rounded-lg border border-gray-200 p-6 flex items-center justify-between shadow-sm hover:border-gray-300 hover:shadow-md transition">
        <div>
          <p class="text-sm font-medium text-gray-500">จำนวนนักเรียน</p>
          <div class="flex items-baseline gap-1">
            <h3 class="text-3xl font-bold text-gray-800"><%= stats?.studentCount || 0 %></h3>
            <span class="text-sm font-medium text-gray-500">คน</span>
          </div>
        </div>
        <div class="p-3  text-blue-500 rounded-lg">
          <svg class="w-6 h-6" fill="none" stroke="green" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </div>
      </a>

    </div>

    <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6 sm:p-8">
      <h2 class="text-lg sm:text-xl font-bold text-gray-800 mb-4 pb-4 border-b border-gray-100 flex items-center gap-2">
        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        รายละเอียดคอร์ส
      </h2>
      
      <div class="text-gray-700 text-sm sm:text-base leading-relaxed">
        <% if (course.description) { %>
            <%- course.description %>
        <% } else { %>
            <p class="text-gray-400 italic">ไม่มีรายละเอียดเพิ่มเติมสำหรับคอร์สนี้</p>
        <% } %>
      </div>
    </div>

  </div>
</section>