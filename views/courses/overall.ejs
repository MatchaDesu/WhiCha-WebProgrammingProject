<section id="course-catalog" class="bg-gray-50 min-h-screen pb-16">
  <div class="container mx-auto px-4 sm:px-6 py-8 sm:py-12 max-w-7xl">

    <div class="mb-8">
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900">สำรวจคอร์สเรียน</h1>
      <p class="text-gray-500 mt-2 text-sm md:text-base">ค้นหาและเลือกเรียนคอร์สที่ใช่สำหรับคุณ</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 lg:gap-8 items-start">

      <aside class="hidden lg:block col-span-1">
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
          <h2 class="text-lg font-bold text-gray-900 mb-4 pb-3 border-b border-gray-100 flex items-center gap-2">
            หมวดหมู่คอร์ส
          </h2>

          <ul class="flex flex-col gap-3">
            <% categories.forEach(category => { %>
            <li>
              <label class="flex items-center gap-3 cursor-pointer group">
                <input type="checkbox" class="w-4 h-4 rounded border-gray-300 text-black accent-black focus:ring-black transition">
                <span class="text-sm font-medium text-gray-600 group-hover:text-black transition">
                  <%= category.category_name %>
                </span>
              </label>
            </li>
            <% }); %>
          </ul>
        </div>
      </aside>

      <div class="col-span-1 lg:col-span-3 flex flex-col gap-6">

        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-3 sm:p-4 gap-4">

          <form action="/courses" method="get" class="w-full sm:flex-1 relative">
            <div class="relative flex items-center">
              <svg class="w-5 h-5 absolute left-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              
              <input type="text" name="search" placeholder="ค้นหาชื่อคอร์สเรียน..." class="w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-900 placeholder-gray-400 focus:bg-white focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition">

              <button type="submit" class="absolute right-2 px-3 py-1.5 bg-black text-white text-xs font-medium rounded-md hover:bg-gray-800 transition">
                ค้นหา
              </button>
            </div>
          </form>

          <div class="w-full sm:w-auto flex items-center justify-between sm:justify-end gap-4 shrink-0">

          </div>
        </div>

        <% if (!courses || courses.length === 0) { %>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-12 text-center">
          <p class="text-gray-500">ไม่พบคอร์สเรียนในขณะนี้</p>
        </div>
        <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">

          <% courses.forEach(course => { %>
          <a href="/courses/<%= course.course_id %>" class="group bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-md hover:border-gray-300 transition-all duration-300 flex flex-col h-full">

            <div class="w-full aspect-video bg-gray-100 relative overflow-hidden shrink-0 border-b border-gray-100">
              <% if (course.course_image) { %>
              <img src="<%= course.course_image %>" alt="<%= course.course_name %>" class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-500">
              <% } else { %>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-gray-400 bg-gray-50">
                <svg class="w-8 h-8 opacity-40 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <span class="text-xs font-medium">No Image</span>
              </div>
              <% } %>
            </div>

            <div class="flex flex-col p-5 flex-1">

              <h2 class="text-lg font-bold text-gray-900 line-clamp-2 mb-2 group-hover:text-black transition">
                <%= course.course_name %>
              </h2>

              <p class="text-sm text-gray-500 line-clamp-2 mb-4 leading-relaxed">
                <%= course.course_description || 'ไม่มีคำอธิบายคอร์ส' %>
              </p>

              <div class="mt-auto flex flex-col gap-4">

                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full overflow-hidden shrink-0 bg-gray-200 border border-gray-200">
                    <img src="<%= course.instructor_profile || '/icon/profile-anonymous.svg' %>" alt="" class="h-full w-full object-cover">
                  </div>
                  <h3 class="text-xs font-semibold text-gray-600 line-clamp-1">
                    <%= course.instructor_name || 'ผู้สอนไม่ระบุชื่อ' %>
                  </h3>
                </div>

                <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                  <span class="text-xl font-bold text-gray-900">
                    ฿ <%= course.course_price || '0.00' %>
                  </span>
                  <span class="text-[11px] font-bold uppercase tracking-wider text-secondary bg-orange-50 px-2.5 py-1 rounded-md">
                    ดูรายละเอียด
                  </span>
                </div>

              </div>

            </div>
          </a>
          <% }); %>

        </div>
        <% } %>

      </div>

    </div>
  </div>
</section>