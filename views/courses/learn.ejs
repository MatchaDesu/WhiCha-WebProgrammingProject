<!-- Toast UI CSS (ใช้เฉพาะหน้านี้) -->
<link rel="stylesheet" href="https://uicdn.toast.com/editor/latest/toastui-editor.min.css" />

<div class="flex h-screen bg-gray-50 overflow-hidden">

  <!-- ===== SIDEBAR ===== -->
  <div class="w-1/3 bg-white border-r p-6 overflow-y-auto">

    <h3 class="text-xl font-bold mb-6">
      <%= course.course_name %>
    </h3>

    <% modules.forEach(module => { %>

    <div class="mb-8">

      <p class="text-sm text-gray-500 uppercase tracking-wide mb-2">
        Chapter <%= module.order_index %>
      </p>

      <p class="font-semibold mb-3">
        <%= module.module_name %>
      </p>

      <ul class="space-y-2">

        <% module.items.forEach(item => { %>
        <li>

          <% if (item.type === "lesson") { %>
          <a href="/courses/<%= course.course_id %>/learn/lesson/<%= item.data.lesson_id %>" class="block px-3 py-2 rounded-lg transition
                                  <%= currentItem && currentItem.type === 'lesson' && currentItem.data.lesson_id === item.data.lesson_id
                                      ? 'bg-blue-100 text-blue-600 font-medium'
                                      : 'text-gray-700 hover:bg-gray-100 hover:text-blue-600' %>">
            📘 <%= item.data.lesson_name %>
          </a>
          <% } %>

          <% if (item.type === "quiz") { %>
          <a href="/courses/<%= course.course_id %>/learn/quiz/<%= item.data.quiz_id %>" class="block px-3 py-2 rounded-lg transition
                                  <%= currentItem && currentItem.type === 'quiz' && currentItem.data.quiz_id === item.data.quiz_id
                                      ? 'bg-green-100 text-green-600 font-medium'
                                      : 'text-gray-700 hover:bg-gray-100 hover:text-green-600' %>">
            📝 <%= item.data.title %>
          </a>
          <% } %>

        </li>
        <% }) %>

      </ul>

    </div>

    <% }) %>

  </div>


  <!-- ===== RIGHT CONTENT ===== -->
  <div class="w-2/3 p-10 flex flex-col h-full overflow-hidden">

    <% if (!currentItem) { %>

    <div class="flex items-center justify-center h-full text-gray-400">
      <h2 class="text-2xl">
        กรุณาเลือกบทเรียนจากด้านซ้าย 👈
      </h2>
    </div>

    <% } else if (currentItem.type === "lesson") { %>

    <h2 class="text-3xl font-bold mb-6 shrink-0">
      <%= currentItem.data.lesson_name %>
    </h2>

    <!-- ===== SCROLL AREA ===== -->
    <div class="flex-1 overflow-y-auto bg-white rounded-xl shadow border p-8">
      <div id="viewer" data-content="<%- currentItem.data.content %>">
      </div>
    </div>

    <% } else if (currentItem.type === "quiz") { %>

    <h2 class="text-3xl font-bold mb-4 shrink-0">
      <%= currentItem.data.title %>
    </h2>

    <div class="flex-1 overflow-y-auto bg-white rounded-xl shadow border p-8">
      <p class="text-gray-700 text-lg">
        <%= currentItem.data.description %>
      </p>
    </div>

    <% } %>

  </div>

</div>


<!-- Toast UI JS (ใช้เฉพาะหน้านี้) -->
<script src="https://uicdn.toast.com/editor/latest/toastui-editor-all.min.js"></script>

<script>
  const viewerEl = document.querySelector('#viewer');

  if (viewerEl) {
    toastui.Editor.factory({
      el: viewerEl,
      viewer: true,
      initialValue: viewerEl.dataset.content
    });
  }
</script>