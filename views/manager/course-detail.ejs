<section class="bg-gray-50 min-h-screen pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

    <!-- Header -->
    <div class="flex items-center gap-3 mb-8">
      <a href="/manager/courses" class="text-gray-400 hover:text-black transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </a>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="text-xl md:text-2xl font-bold text-gray-900 truncate"><%= course.course_name %></h1>
          <span class="shrink-0 text-[10px] font-bold px-2.5 py-1 rounded-full border
            <%= course.course_status === 'published' ? 'bg-green-50 text-green-700 border-green-200'
              : course.course_status === 'pending'   ? 'bg-yellow-50 text-yellow-700 border-yellow-200'
              : course.course_status === 'rejected'  ? 'bg-red-50 text-red-600 border-red-200'
              : 'bg-gray-50 text-gray-500 border-gray-200' %>">
            <%= course.course_status %>
          </span>
        </div>
        <p class="text-gray-500 text-sm mt-0.5">โดย <%= course.instructor_name %></p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- ── Left: Course Info + Modules ── -->
      <div class="lg:col-span-2 flex flex-col gap-6">

        <!-- Cover Image -->
        <% if (course.course_image) { %>
          <div class="w-full aspect-video rounded-xl overflow-hidden bg-gray-100 border border-gray-200 shadow-sm">
            <img src="<%= course.course_image %>" class="w-full h-full object-cover">
          </div>
        <% } %>

        <!-- Description -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">
          <h2 class="text-sm font-bold text-gray-700 uppercase tracking-widest mb-3">คำอธิบาย</h2>
          <p class="text-sm text-gray-600 leading-relaxed"><%= course.description || 'ไม่มีคำอธิบาย' %></p>
        </div>

        <!-- Modules + Items -->
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100">
            <h2 class="text-sm font-bold text-gray-700 uppercase tracking-widest">เนื้อหาคอร์ส</h2>
          </div>

          <% if (!modules || modules.length === 0) { %>
            <div class="p-10 text-center text-gray-400 text-sm">ยังไม่มีเนื้อหา</div>
          <% } else { %>
            <div class="divide-y divide-gray-100">
              <% modules.forEach((mod, mIdx) => { %>
                <div>
                  <!-- Module Header -->
                  <button onclick="toggleModule(<%= mIdx %>)"
                    class="w-full flex items-center justify-between px-6 py-4 hover:bg-gray-50 transition text-left">
                    <div class="flex items-center gap-3">
                      <span class="w-6 h-6 rounded-full bg-gray-100 text-gray-600 text-xs font-bold flex items-center justify-center shrink-0">
                        <%= mIdx + 1 %>
                      </span>
                      <span class="font-semibold text-gray-900 text-sm"><%= mod.module_name %></span>
                      <span class="text-xs text-gray-400"><%= mod.items ? mod.items.length : 0 %> รายการ</span>
                    </div>
                    <svg id="chevron-<%= mIdx %>" class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </button>

                  <!-- Module Items -->
                  <div id="module-<%= mIdx %>" class="border-t border-gray-100 divide-y divide-gray-50">
                    <% if (mod.items && mod.items.length > 0) { %>
                      <% mod.items.forEach(item => { %>
                        <div class="flex items-center gap-3 px-6 py-3 bg-gray-50/50 pl-14">
                          <% if (item.type === 'lesson') { %>
                            <div class="p-1.5 bg-orange-100 text-orange-500 rounded shrink-0">
                              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M2 6a2 2 0 012-2h6a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6zM14.553 7.106A1 1 0 0014 8v4a1 1 0 00.553.894l2 1A1 1 0 0018 13V7a1 1 0 00-1.447-.894l-2 1z"></path>
                              </svg>
                            </div>
                            <span class="text-xs text-gray-700 flex-1"><%= item.data.lesson_name %></span>
                            <span class="text-[10px] font-bold text-orange-600 bg-orange-50 px-2 py-0.5 rounded border border-orange-200">Lesson</span>
                          <% } else { %>
                            <div class="p-1.5 bg-purple-100 text-purple-500 rounded shrink-0">
                              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                              </svg>
                            </div>
                            <span class="text-xs text-gray-700 flex-1"><%= item.data.title %></span>
                            <span class="text-[10px] font-bold text-purple-600 bg-purple-50 px-2 py-0.5 rounded border border-purple-200">
                              Quiz · <%= item.data.questions ? item.data.questions.length : 0 %> ข้อ
                            </span>
                          <% } %>
                        </div>
                      <% }) %>
                    <% } else { %>
                      <p class="px-14 py-3 text-xs text-gray-400 bg-gray-50/50">ไม่มีรายการ</p>
                    <% } %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- Rejection reason (if rejected) -->
        <% if (course.course_status === 'rejected' && course.rejection_reason) { %>
          <div class="bg-red-50 border border-red-200 rounded-xl p-5">
            <p class="text-xs font-bold text-red-700 uppercase tracking-widest mb-1">เหตุผลที่ปฏิเสธ</p>
            <p class="text-sm text-red-600"><%= course.rejection_reason %></p>
          </div>
        <% } %>

      </div>

      <!-- ── Right: Sticky Action Panel ── -->
      <div class="lg:col-span-1">
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-5 sticky top-6">

          <!-- Stats -->
          <div class="grid grid-cols-2 gap-3 mb-5">
            <div class="bg-gray-50 rounded-lg p-3 text-center border border-gray-100">
              <p class="text-xl font-bold text-gray-900"><%= stats.moduleCount %></p>
              <p class="text-[10px] text-gray-400 mt-0.5">Modules</p>
            </div>
            <div class="bg-gray-50 rounded-lg p-3 text-center border border-gray-100">
              <p class="text-xl font-bold text-gray-900"><%= stats.lessonCount %></p>
              <p class="text-[10px] text-gray-400 mt-0.5">Lessons</p>
            </div>
            <div class="bg-gray-50 rounded-lg p-3 text-center border border-gray-100">
              <p class="text-xl font-bold text-gray-900"><%= stats.quizCount %></p>
              <p class="text-[10px] text-gray-400 mt-0.5">Quizzes</p>
            </div>
            <div class="bg-gray-50 rounded-lg p-3 text-center border border-gray-100">
              <p class="text-xl font-bold text-gray-900">
                <%= course.course_price > 0 ? '฿' + course.course_price : 'ฟรี' %>
              </p>
              <p class="text-[10px] text-gray-400 mt-0.5">ราคา</p>
            </div>
          </div>

          <!-- Instructor -->
          <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-lg border border-gray-100 mb-5">
            <div class="w-9 h-9 rounded-full overflow-hidden bg-gray-200 shrink-0 border border-gray-200">
              <img src="<%= course.instructor_image %>" class="w-full h-full object-cover">
            </div>
            <div class="min-w-0">
              <p class="text-xs font-semibold text-gray-800 truncate"><%= course.instructor_name %></p>
              <p class="text-[10px] text-gray-400">Instructor</p>
            </div>
          </div>

          <!-- Action Buttons (pending only) -->
          <% if (course.course_status === 'pending') { %>
            <div class="flex flex-col gap-2">
              <button onclick="openApproveModal(<%= course.course_id %>, '<%= course.course_name.replace(/'/g, "\\'") %>')"
                class="w-full py-2.5 text-sm font-bold text-white bg-black rounded-lg hover:bg-gray-800 transition">
                อนุมัติคอร์สนี้ ✓
              </button>
              <button onclick="openRejectModal(<%= course.course_id %>, '<%= course.course_name.replace(/'/g, "\\'") %>')"
                class="w-full py-2.5 text-sm font-bold text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition">
                ปฏิเสธ
              </button>
            </div>
          <% } %>

          <p class="text-[10px] text-gray-400 text-center mt-4">
            สร้างเมื่อ <%= new Date(course.created_at).toLocaleDateString('th-TH') %>
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Approve Modal -->
<div id="approve-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
    <div class="w-12 h-12 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4 border border-green-200">
      <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h3 class="text-base font-bold text-gray-900 text-center mb-1">ยืนยันการอนุมัติ</h3>
    <p id="approve-course-name" class="text-sm font-semibold text-gray-800 text-center mb-6"></p>
    <form id="approve-form" method="POST">
      <div class="flex justify-center gap-3">
        <button type="button" onclick="closeApproveModal()" class="px-5 py-2 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition">ยกเลิก</button>
        <button type="submit" class="px-5 py-2 text-sm font-semibold text-white bg-black rounded-lg hover:bg-gray-800 transition">ยืนยันอนุมัติ</button>
      </div>
    </form>
  </div>
</div>

<!-- Reject Modal -->
<div id="reject-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
    <h3 class="text-base font-bold text-gray-900 mb-1">ปฏิเสธคอร์ส</h3>
    <p id="reject-course-name" class="text-sm text-gray-500 mb-4"></p>
    <form id="reject-form" method="POST">
      <label class="block text-xs font-semibold text-gray-700 mb-1.5">เหตุผล <span class="text-red-500">*</span></label>
      <textarea name="rejection_reason" rows="3" required
        class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition resize-none"
        placeholder="ระบุเหตุผล..."></textarea>
      <div class="flex justify-end gap-3 mt-4">
        <button type="button" onclick="closeRejectModal()" class="px-4 py-2 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition">ยกเลิก</button>
        <button type="submit" class="px-4 py-2 text-sm font-semibold text-white bg-red-600 rounded-lg hover:bg-red-700 transition">ยืนยันปฏิเสธ</button>
      </div>
    </form>
  </div>
</div>

<script>
  // Toggle module accordion
  function toggleModule(idx) {
    const content  = document.getElementById(`module-${idx}`);
    const chevron  = document.getElementById(`chevron-${idx}`);
    const isHidden = content.style.display === 'none';
    content.style.display  = isHidden ? '' : 'none';
    chevron.style.transform = isHidden ? 'rotate(180deg)' : '';
  }

  function openApproveModal(courseId, courseName) {
    document.getElementById('approve-course-name').textContent = courseName;
    document.getElementById('approve-form').action = `/manager/courses/${courseId}/approve`;
    const m = document.getElementById('approve-modal');
    m.classList.remove('hidden'); m.classList.add('flex');
  }
  function closeApproveModal() {
    const m = document.getElementById('approve-modal');
    m.classList.add('hidden'); m.classList.remove('flex');
  }
  function openRejectModal(courseId, courseName) {
    document.getElementById('reject-course-name').textContent = courseName;
    document.getElementById('reject-form').action = `/manager/courses/${courseId}/reject`;
    const m = document.getElementById('reject-modal');
    m.classList.remove('hidden'); m.classList.add('flex');
  }
  function closeRejectModal() {
    const m = document.getElementById('reject-modal');
    m.classList.add('hidden'); m.classList.remove('flex');
  }
  ['approve-modal','reject-modal'].forEach(id => {
    document.getElementById(id).addEventListener('click', function(e) {
      if (e.target === this) this.id === 'approve-modal' ? closeApproveModal() : closeRejectModal();
    });
  });
</script>
