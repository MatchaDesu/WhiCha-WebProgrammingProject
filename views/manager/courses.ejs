<section class="bg-gray-50 min-h-screen pb-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

    <!-- Header -->
    <div class="flex items-center gap-3 mb-8">
      <a href="/manager" class="text-gray-400 hover:text-black transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </a>
      <div>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900">คอร์สทั้งหมด</h1>
        <p class="text-gray-500 text-sm mt-0.5"><%= courses.length %> คอร์ส</p>
      </div>
    </div>

    <!-- Search + Filter -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 mb-6 flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input id="search-input" type="text" placeholder="ค้นหาชื่อคอร์ส, ผู้สอน..."
          class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition">
      </div>
      <div class="flex gap-2 flex-wrap">
        <% ['all','published','pending','draft','rejected'].forEach(s => { %>
          <button onclick="filterStatus('<%= s %>')" data-status="<%= s %>"
            class="status-btn px-3 py-2 text-xs font-semibold rounded-lg border transition
              <%= s === 'all' ? 'border-black bg-black text-white' : 'border-gray-200 text-gray-600 hover:bg-gray-50' %>">
            <%= s === 'all' ? 'ทั้งหมด'
              : s === 'published' ? 'Published'
              : s === 'pending'   ? 'Pending'
              : s === 'draft'     ? 'Draft'
              : 'Rejected' %>
          </button>
        <% }) %>
      </div>
    </div>

    <!-- Course List -->
    <div id="courses-list" class="flex flex-col gap-4">
      <% courses.forEach(course => { %>
        <div class="course-row bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md transition"
          data-name="<%= (course.course_name + ' ' + course.instructor_name).toLowerCase() %>"
          data-status="<%= course.course_status %>">

          <div class="flex gap-4 p-5">
            <!-- Thumbnail -->
            <div class="w-24 h-16 sm:w-36 sm:h-24 rounded-lg overflow-hidden bg-gray-100 shrink-0">
              <% if (course.course_image) { %>
                <img src="<%= course.course_image %>" class="w-full h-full object-cover">
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center text-gray-300">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              <% } %>
            </div>

            <!-- Info -->
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-3 mb-1">
                <h3 class="font-bold text-gray-900 text-sm sm:text-base line-clamp-1">
                  <%= course.course_name %>
                </h3>
                <span class="shrink-0 text-[10px] font-bold px-2 py-0.5 rounded-full border
                  <%= course.course_status === 'published' ? 'bg-green-50 text-green-700 border-green-200'
                    : course.course_status === 'pending'   ? 'bg-yellow-50 text-yellow-700 border-yellow-200'
                    : course.course_status === 'rejected'  ? 'bg-red-50 text-red-600 border-red-200'
                    : 'bg-gray-50 text-gray-500 border-gray-200' %>">
                  <%= course.course_status %>
                </span>
              </div>
              <p class="text-xs text-gray-500 mb-2 line-clamp-2 hidden sm:block"><%= course.description || '-' %></p>
              <div class="flex items-center gap-3 flex-wrap text-xs text-gray-400">
                <span>โดย <span class="font-semibold text-gray-600"><%= course.instructor_name %></span></span>
                <span>•</span>
                <span><%= course.course_price > 0 ? '฿' + course.course_price : 'ฟรี' %></span>
                <span>•</span>
                <span><%= new Date(course.created_at).toLocaleDateString('th-TH') %></span>
              </div>
              <% if (course.course_status === 'rejected' && course.rejection_reason) { %>
                <div class="mt-2 text-xs text-red-600 bg-red-50 border border-red-100 rounded-lg px-3 py-2">
                  <span class="font-semibold">เหตุผลที่ปฏิเสธ:</span> <%= course.rejection_reason %>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Footer -->
          <div class="border-t border-gray-100 px-5 py-3 bg-gray-50 flex items-center justify-between gap-3">
            <a href="/manager/courses/<%= course.course_id %>"
              class="text-xs font-semibold text-gray-600 hover:text-black underline underline-offset-2 transition">
              ดูรายละเอียด →
            </a>
            <% if (course.course_status === 'pending') { %>
              <div class="flex gap-2">
                <button onclick="openRejectModal(<%= course.course_id %>, '<%= course.course_name.replace(/'/g, "\\'") %>')"
                  class="px-3 py-1.5 text-xs font-semibold text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition">
                  ปฏิเสธ
                </button>
                <button onclick="openApproveModal(<%= course.course_id %>, '<%= course.course_name.replace(/'/g, "\\'") %>')"
                  class="px-3 py-1.5 text-xs font-semibold text-white bg-black rounded-lg hover:bg-gray-800 transition">
                  อนุมัติ ✓
                </button>
              </div>
            <% } %>
          </div>

        </div>
      <% }) %>
    </div>

    <div id="empty-state" class="hidden bg-white border border-gray-200 rounded-xl p-12 text-center shadow-sm">
      <p class="text-gray-400 text-sm">ไม่พบคอร์ส</p>
    </div>

  </div>
</section>

<!-- Approve Modal -->
<div id="approve-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
    <div class="w-12 h-12 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4 border border-green-200">
      <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h3 class="text-base font-bold text-gray-900 text-center mb-1">ยืนยันการอนุมัติ</h3>
    <p id="approve-course-name" class="text-sm font-semibold text-gray-800 text-center mb-6"></p>
    <form id="approve-form" method="POST">
      <div class="flex justify-center gap-3">
        <button type="button" onclick="closeApproveModal()" class="px-5 py-2 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition">ยกเลิก</button>
        <button type="submit" class="px-5 py-2 text-sm font-semibold text-white bg-black rounded-lg hover:bg-gray-800 transition">ยืนยันอนุมัติ</button>
      </div>
    </form>
  </div>
</div>

<!-- Reject Modal -->
<div id="reject-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
    <h3 class="text-base font-bold text-gray-900 mb-1">ปฏิเสธคอร์ส</h3>
    <p id="reject-course-name" class="text-sm text-gray-500 mb-4"></p>
    <form id="reject-form" method="POST">
      <label class="block text-xs font-semibold text-gray-700 mb-1.5">เหตุผล <span class="text-red-500">*</span></label>
      <textarea name="rejection_reason" rows="3" required
        class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition resize-none"
        placeholder="ระบุเหตุผล..."></textarea>
      <div class="flex justify-end gap-3 mt-4">
        <button type="button" onclick="closeRejectModal()" class="px-4 py-2 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition">ยกเลิก</button>
        <button type="submit" class="px-4 py-2 text-sm font-semibold text-white bg-red-600 rounded-lg hover:bg-red-700 transition">ยืนยันปฏิเสธ</button>
      </div>
    </form>
  </div>
</div>

<script>
  let currentStatus = 'all';

  function filterStatus(status) {
    currentStatus = status;
    document.querySelectorAll('.status-btn').forEach(btn => {
      const active = btn.dataset.status === status;
      btn.classList.toggle('bg-black', active);
      btn.classList.toggle('text-white', active);
      btn.classList.toggle('border-black', active);
      btn.classList.toggle('text-gray-600', !active);
      btn.classList.toggle('border-gray-200', !active);
    });
    applyFilters();
  }

  document.getElementById('search-input').addEventListener('input', applyFilters);

  function applyFilters() {
    const keyword = document.getElementById('search-input').value.toLowerCase();
    let visible = 0;
    document.querySelectorAll('.course-row').forEach(row => {
      const matchStatus = currentStatus === 'all' || row.dataset.status === currentStatus;
      const matchName   = row.dataset.name.includes(keyword);
      const show = matchStatus && matchName;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    document.getElementById('empty-state').classList.toggle('hidden', visible > 0);
  }

  function openApproveModal(courseId, courseName) {
    document.getElementById('approve-course-name').textContent = courseName;
    document.getElementById('approve-form').action = `/manager/courses/${courseId}/approve`;
    const m = document.getElementById('approve-modal');
    m.classList.remove('hidden'); m.classList.add('flex');
  }
  function closeApproveModal() {
    const m = document.getElementById('approve-modal');
    m.classList.add('hidden'); m.classList.remove('flex');
  }
  function openRejectModal(courseId, courseName) {
    document.getElementById('reject-course-name').textContent = courseName;
    document.getElementById('reject-form').action = `/manager/courses/${courseId}/reject`;
    const m = document.getElementById('reject-modal');
    m.classList.remove('hidden'); m.classList.add('flex');
  }
  function closeRejectModal() {
    const m = document.getElementById('reject-modal');
    m.classList.add('hidden'); m.classList.remove('flex');
  }
  ['approve-modal','reject-modal'].forEach(id => {
    document.getElementById(id).addEventListener('click', function(e) {
      if (e.target === this) this.id === 'approve-modal' ? closeApproveModal() : closeRejectModal();
    });
  });
</script>
