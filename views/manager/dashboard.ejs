<section class="bg-gray-50 min-h-screen pb-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Manager Dashboard</h1>
      <p class="text-gray-500 mt-1 text-sm">ภาพรวมและจัดการคอร์สบนแพลตฟอร์ม</p>
    </div>

    <!-- ── Stats Overview ── -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-10">

      <a href="/manager/users"
        class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm hover:shadow-md hover:border-gray-300 transition group">
        <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-1">ผู้ใช้ทั้งหมด</p>
        <p class="text-3xl font-bold text-gray-900 group-hover:text-black"><%= stats.totalUsers %></p>
        <p class="text-xs text-gray-400 mt-2 group-hover:text-gray-600">ดูทั้งหมด →</p>
      </a>

      <a href="/manager/courses"
        class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm hover:shadow-md hover:border-gray-300 transition group">
        <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-1">คอร์สทั้งหมด</p>
        <p class="text-3xl font-bold text-gray-900 group-hover:text-black"><%= stats.totalCourses %></p>
        <p class="text-xs text-gray-400 mt-2 group-hover:text-gray-600">ดูทั้งหมด →</p>
      </a>

      <a href="/manager/enrollments"
        class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm hover:shadow-md hover:border-gray-300 transition group">
        <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-1">การลงทะเบียน</p>
        <p class="text-3xl font-bold text-gray-900 group-hover:text-black"><%= stats.totalEnrollments %></p>
        <p class="text-xs text-gray-400 mt-2 group-hover:text-gray-600">ดูทั้งหมด →</p>
      </a>

      <a href="#pending-section"
        class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm hover:shadow-md hover:border-gray-300 transition group relative overflow-hidden">
        <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-1">รอ Approve</p>
        <p class="text-3xl font-bold text-gray-900 group-hover:text-black"><%= pendingCourses.length %></p>
        <p class="text-xs text-gray-400 mt-2 group-hover:text-gray-600">ดูรายการ →</p>
        <% if (pendingCourses.length > 0) { %>
          <span class="absolute top-4 right-4 w-2.5 h-2.5 bg-yellow-400 rounded-full animate-pulse"></span>
        <% } %>
      </a>

    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">

      <!-- ── Pending Courses (ซ้าย, กว้างกว่า) ── -->
      <div id="pending-section" class="xl:col-span-2 flex flex-col gap-4">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold text-gray-900">คอร์สรอการอนุมัติ</h2>
          <% if (pendingCourses.length > 0) { %>
            <span class="text-xs font-bold px-2.5 py-1 bg-yellow-50 text-yellow-700 border border-yellow-200 rounded-full">
              <%= pendingCourses.length %> รายการ
            </span>
          <% } %>
        </div>

        <% if (pendingCourses.length === 0) { %>
          <div class="bg-white border border-gray-200 rounded-xl p-12 text-center shadow-sm">
            <div class="w-12 h-12 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-3 border border-green-200">
              <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <p class="text-gray-500 font-medium text-sm">ไม่มีคอร์สรอการอนุมัติ</p>
          </div>
        <% } else { %>
          <div class="flex flex-col gap-4">
            <% pendingCourses.forEach(course => { %>
              <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">

                <div class="flex gap-4 p-5">
                  <!-- Thumbnail -->
                  <div class="w-24 h-16 sm:w-32 sm:h-20 rounded-lg overflow-hidden bg-gray-100 shrink-0">
                    <% if (course.course_image) { %>
                      <img src="<%= course.course_image %>" class="w-full h-full object-cover">
                    <% } else { %>
                      <div class="w-full h-full flex items-center justify-center text-gray-300">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                      </div>
                    <% } %>
                  </div>

                  <!-- Info -->
                  <div class="flex-1 min-w-0">
                    <h3 class="font-bold text-gray-900 text-sm sm:text-base line-clamp-1 mb-1">
                      <%= course.course_name %>
                    </h3>
                    <p class="text-xs text-gray-500 mb-2 line-clamp-2"><%= course.description || '-' %></p>
                    <div class="flex items-center gap-3 flex-wrap text-xs text-gray-400">
                      <span>โดย <span class="font-semibold text-gray-600"><%= course.instructor_name %></span></span>
                      <span>•</span>
                      <span><%= course.course_price > 0 ? '฿' + course.course_price : 'ฟรี' %></span>
                      <span>•</span>
                      <span><%= new Date(course.created_at).toLocaleDateString('th-TH') %></span>
                    </div>
                  </div>
                </div>

                <!-- Actions -->
                <div class="border-t border-gray-100 px-5 py-3 flex items-center justify-between gap-3 bg-gray-50">
                  <!-- ดูคอร์ส -->
                  <a href="/manager/courses/<%= course.course_id %>"
                    class="text-xs font-semibold text-gray-500 hover:text-black underline underline-offset-2 transition">
                    ดูเนื้อหาคอร์ส →
                  </a>
                  <div class="flex items-center gap-3">
                    <button onclick="openRejectModal(<%= course.course_id %>, '<%= course.course_name.replace(/'/g, "\\'") %>')"
                      class="px-4 py-2 text-xs font-semibold text-red-600 bg-red-50 border border-red-200 rounded-lg hover:bg-red-100 transition">
                      ปฏิเสธ
                    </button>
                    <button onclick="openApproveModal(<%= course.course_id %>, '<%= course.course_name.replace(/'/g, "\\'") %>')"
                      class="px-4 py-2 text-xs font-semibold text-white bg-black rounded-lg hover:bg-gray-800 transition">
                      อนุมัติ ✓
                    </button>
                  </div>
                </div>

              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- ── Right Column: Users ── -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-gray-900">ผู้ใช้ล่าสุด</h2>
          <a href="/manager/users" class="text-xs font-semibold text-gray-500 hover:text-black underline underline-offset-2 transition">
            ดูทั้งหมด →
          </a>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden divide-y divide-gray-100">
          <% users.forEach(u => { %>
            <div class="flex items-center gap-3 px-4 py-3">
              <div class="w-8 h-8 rounded-full overflow-hidden bg-gray-100 shrink-0 border border-gray-200">
                <img src="<%= u.profile_image || '/icon/profile-anonymous.svg' %>" class="w-full h-full object-cover">
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-xs font-semibold text-gray-800 line-clamp-1"><%= u.first_name %> <%= u.last_name %></p>
                <p class="text-[10px] text-gray-400"><%= u.email %></p>
              </div>
              <span class="shrink-0 text-[10px] font-bold px-2 py-0.5 rounded-full border
                <%= u.role === 'instructor' ? 'bg-blue-50 text-blue-700 border-blue-200'
                  : u.role === 'manager'    ? 'bg-purple-50 text-purple-700 border-purple-200'
                  : 'bg-gray-50 text-gray-600 border-gray-200' %>">
                <%= u.role %>
              </span>
            </div>
          <% }) %>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ── Approve Modal ── -->
<div id="approve-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
    <div class="w-12 h-12 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-4 border border-green-200">
      <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
      </svg>
    </div>
    <h3 class="text-base font-bold text-gray-900 text-center mb-1">ยืนยันการอนุมัติ</h3>
    <p class="text-sm text-gray-500 text-center mb-1">คุณต้องการอนุมัติคอร์สนี้ใช่ไหม?</p>
    <p id="approve-course-name" class="text-sm font-semibold text-gray-800 text-center mb-6"></p>

    <form id="approve-form" method="POST">
      <div class="flex justify-center gap-3">
        <button type="button" onclick="closeApproveModal()"
          class="px-5 py-2 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
          ยกเลิก
        </button>
        <button type="submit"
          class="px-5 py-2 text-sm font-semibold text-white bg-black rounded-lg hover:bg-gray-800 transition">
          ยืนยันอนุมัติ
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ── Reject Modal ── -->
<div id="reject-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 px-4">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
    <h3 class="text-base font-bold text-gray-900 mb-1">ปฏิเสธคอร์ส</h3>
    <p id="reject-course-name" class="text-sm text-gray-500 mb-4"></p>

    <form id="reject-form" method="POST">
      <label class="block text-xs font-semibold text-gray-700 mb-1.5">เหตุผลที่ปฏิเสธ <span class="text-red-500">*</span></label>
      <textarea name="rejection_reason" rows="3" required
        placeholder="เช่น เนื้อหายังไม่ครบถ้วน กรุณาเพิ่ม Quiz อย่างน้อย 1 ชุดต่อ Module"
        class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition resize-none"></textarea>

      <div class="flex justify-end gap-3 mt-5">
        <button type="button" onclick="closeRejectModal()"
          class="px-4 py-2 text-sm font-semibold text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
          ยกเลิก
        </button>
        <button type="submit"
          class="px-4 py-2 text-sm font-semibold text-white bg-red-600 rounded-lg hover:bg-red-700 transition">
          ยืนยันปฏิเสธ
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openApproveModal(courseId, courseName) {
    document.getElementById('approve-course-name').textContent = courseName;
    document.getElementById('approve-form').action = `/manager/courses/${courseId}/approve`;
    const modal = document.getElementById('approve-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
  function closeApproveModal() {
    const modal = document.getElementById('approve-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  function openRejectModal(courseId, courseName) {
    document.getElementById('reject-course-name').textContent = courseName;
    document.getElementById('reject-form').action = `/manager/courses/${courseId}/reject`;
    const modal = document.getElementById('reject-modal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
  function closeRejectModal() {
    const modal = document.getElementById('reject-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  // close on backdrop click
  ['approve-modal', 'reject-modal'].forEach(id => {
    document.getElementById(id).addEventListener('click', function(e) {
      if (e.target === this) this.id === 'approve-modal' ? closeApproveModal() : closeRejectModal();
    });
  });
</script>
