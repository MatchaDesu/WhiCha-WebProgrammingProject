<section class="bg-gray-50 min-h-screen pb-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12">

    <!-- Header -->
    <div class="flex items-center gap-3 mb-8">
      <a href="/manager" class="text-gray-400 hover:text-black transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </a>
      <div>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900">การลงทะเบียนทั้งหมด</h1>
        <p class="text-gray-500 text-sm mt-0.5"><%= enrollments.length %> รายการ</p>
      </div>
    </div>

    <!-- Search -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-4 mb-6">
      <div class="relative max-w-md">
        <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input id="search-input" type="text" placeholder="ค้นหาชื่อนักเรียน, คอร์ส..."
          class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition">
      </div>
    </div>

    <!-- Table -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-100 bg-gray-50">
            <th class="text-left px-5 py-3 text-xs font-bold text-gray-500 uppercase tracking-wider">นักเรียน</th>
            <th class="text-left px-5 py-3 text-xs font-bold text-gray-500 uppercase tracking-wider">คอร์ส</th>
            <th class="text-left px-5 py-3 text-xs font-bold text-gray-500 uppercase tracking-wider hidden md:table-cell">ผู้สอน</th>
            <th class="text-left px-5 py-3 text-xs font-bold text-gray-500 uppercase tracking-wider hidden sm:table-cell">ลงทะเบียนเมื่อ</th>
          </tr>
        </thead>
        <tbody id="enrollment-table" class="divide-y divide-gray-100">
          <% enrollments.forEach(e => { %>
            <tr class="enrollment-row hover:bg-gray-50 transition"
              data-name="<%= (e.student_name + ' ' + e.course_name).toLowerCase() %>">
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full overflow-hidden bg-gray-100 shrink-0 border border-gray-200">
                    <img src="<%= e.profile_image || '/icon/profile-anonymous.svg' %>" class="w-full h-full object-cover">
                  </div>
                  <div>
                    <p class="font-semibold text-gray-900 text-xs"><%= e.student_name %></p>
                    <p class="text-[10px] text-gray-400"><%= e.email %></p>
                  </div>
                </div>
              </td>
              <td class="px-5 py-3.5">
                <a href="/manager/courses/<%= e.course_id %>"
                  class="text-xs font-semibold text-gray-800 hover:text-black hover:underline underline-offset-2 line-clamp-1">
                  <%= e.course_name %>
                </a>
              </td>
              <td class="px-5 py-3.5 text-xs text-gray-500 hidden md:table-cell"><%= e.instructor_name %></td>
              <td class="px-5 py-3.5 text-xs text-gray-400 hidden sm:table-cell">
                <%= new Date(e.enrolled_at).toLocaleDateString('th-TH') %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <% if (enrollments.length === 0) { %>
        <div class="p-12 text-center text-gray-400 text-sm">ไม่มีข้อมูลการลงทะเบียน</div>
      <% } %>
    </div>

  </div>
</section>

<script>
  document.getElementById('search-input').addEventListener('input', function() {
    const keyword = this.value.toLowerCase();
    document.querySelectorAll('.enrollment-row').forEach(row => {
      row.style.display = row.dataset.name.includes(keyword) ? '' : 'none';
    });
  });
</script>
