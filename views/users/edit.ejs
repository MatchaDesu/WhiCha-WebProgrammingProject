<div class="w-full h-40 bg-amber-100"></div>

<div class="container max-w-7xl mx-auto flex flex-col items-center px-6 py-6 pb-20 min-h-screen">

    <form class="flex flex-col w-full max-w-3xl gap-8" action="/upload/upload-user-profile/<%= user.user_id %>" method="POST" enctype="multipart/form-data">

        <div class="-mt-24 flex flex-col items-center justify-center gap-4">
            <div class="h-40 w-40 aspect-square rounded-full overflow-hidden bg-white border-4 border-white cursor-pointer" onclick="document.getElementById('profileImage').click()">
                <img id="imagePreview" src="<%= user.profile_image %>" class="w-full h-full object-cover">
            </div>

            <input type="file" id="profileImage" name="profile" accept="image/*" class="hidden" onchange="previewImage(event)">

            <button type="button" onclick="document.getElementById('profileImage').click()" class="px-6 py-2 bg-secondary text-white rounded-md text-sm md:text-base">
                เปลี่ยนรูปโปรไฟล์
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
            
            <div class="md:col-span-2">
                <label class="block text-sm md:text-lg font-medium mb-2">ชื่อผู้ใช้</label>
                <input type="text" name="username" value="<%= user.username %>" required
                    class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>

            <div>
                <label class="block text-sm md:text-lg font-medium mb-2">ชื่อจริง</label>
                <input type="text" name="first_name" value="<%= user.first_name %>" required
                    class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>

            <div>
                <label class="block text-sm md:text-lg font-medium mb-2">นามสกุล</label>
                <input type="text" name="last_name" value="<%= user.last_name %>" required
                    class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>

            <div>
                <label class="block text-sm md:text-lg font-medium mb-2">อีเมล</label>
                <input type="email" name="email" value="<%= user.email %>" required
                    class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>

            <div>
                <label class="block text-sm md:text-lg font-medium mb-2">เบอร์โทร</label>
                <input type="tel" name="phone" value="<%= user.phone %>" required
                    class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>

            <div>
                <label class="block text-sm md:text-lg font-medium mb-2">รหัสผ่านใหม่ <span class="text-sm text-gray-400 font-normal">(ไม่ต้องกรอกหากไม่ต้องการเปลี่ยน)</span></label>
                <input type="password" name="password"
                    class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>

            <div>
                <label class="block text-sm md:text-lg font-medium mb-2">ยืนยันรหัสผ่าน</label>
                <input type="password" name="confirm_password"
                    class="w-full border rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-secondary">
            </div>

        </div>

        <div class="flex justify-center gap-4 mt-4">
            <a href="/users/<%= user.user_id %>" class="px-6 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50">
                ยกเลิก
            </a>
            <button type="submit" class="px-6 py-2 bg-secondary text-white rounded-md">
                บันทึกการเปลี่ยนแปลง
            </button>
        </div>

    </form>

</div>

<script src="/js/scripts.js"></script>
<script>
    function previewImage(event) {
        const reader = new FileReader();
        reader.onload = function() {
            const output = document.getElementById('imagePreview');
            output.src = reader.result;
        };
        if(event.target.files[0]) {
            reader.readAsDataURL(event.target.files[0]);
        }
    }
</script>