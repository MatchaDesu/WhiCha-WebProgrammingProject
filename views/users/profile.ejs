<div class="w-full h-40 bg-amber-100"></div>

<div class="container max-w-7xl mx-auto px-6 py-6 pb-20 flex flex-col gap-12">

  <!-- ── Profile Header ── -->
  <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-6 border-b border-gray-200 pb-8">

    <div class="flex flex-col items-center md:flex-row gap-6 md:gap-8">
      <div class="-mt-20 flex justify-center shrink-0">
        <div class="h-40 w-40 aspect-square rounded-full overflow-hidden bg-white border-4 border-white shadow-sm">
          <img src="<%= user.profile_image || '/icon/profile-anonymous.svg' %>" class="w-full h-full object-cover">
        </div>
      </div>

      <div class="flex flex-col items-center md:items-start text-center md:text-left mt-2 md:mt-0">
        <h1 class="text-3xl md:text-4xl font-semibold text-gray-900 mb-1">
          <%= user.username %>
        </h1>
        <p class="text-gray-500 text-lg mb-2">
          <%= user.first_name %> <%= user.last_name %>
        </p>
        <span class="inline-block px-3 py-1 bg-gray-100 text-gray-700 text-xs font-medium rounded-md">
          <% if (user.role === 'instructor') { %>ผู้สอน (Instructor)
          <% } else if (user.role === 'manager') { %>ผู้ดูแล (Manager)
          <% } else { %>ผู้เรียน (Student)
          <% } %>
        </span>
      </div>
    </div>

    <div class="mt-4 md:mt-0">
      <a href="/users/<%= user.user_id %>/edit"
        class="px-6 py-2.5 bg-black text-white rounded-md hover:bg-gray-800 transition font-medium inline-block text-center w-full md:w-auto">
        แก้ไขโปรไฟล์
      </a>
    </div>
  </div>

  <!-- ── Enrolled Courses ── -->
  <% if (enrolledCourses && enrolledCourses.length > 0) { %>
  <section>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl md:text-2xl font-bold text-gray-900">คอร์สที่กำลังเรียน</h2>
      <a href="/my-learning" class="text-sm font-medium text-gray-600 hover:underline">ดูทั้งหมด</a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% enrolledCourses.forEach(course => { %>
        <a href="/courses/<%= course.course_id %>/learn"
          class="border border-gray-200 rounded-xl overflow-hidden bg-white flex flex-col h-full hover:shadow-md transition">
          <div class="w-full aspect-video bg-gray-100">
            <% if (course.course_image) { %>
              <img src="<%= course.course_image %>" alt="<%= course.course_name %>" class="w-full h-full object-cover">
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center text-gray-300">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
            <% } %>
          </div>
          <div class="p-4 flex flex-col flex-1">
            <h3 class="font-semibold text-gray-900 line-clamp-2 mb-2"><%= course.course_name %></h3>
            <p class="text-sm text-gray-500 mb-3">เรียนไปแล้ว <%= course.progress || 0 %>%</p>
            <div class="w-full bg-gray-100 rounded-full h-1.5 mt-auto">
              <div class="bg-black h-1.5 rounded-full" style="width: <%= course.progress || 0 %>%"></div>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <!-- ── Teaching Courses (instructor only) ── -->
  <% if (user.role === 'instructor' && teachingCourses && teachingCourses.length > 0) { %>
  <section>
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl md:text-2xl font-bold text-gray-900">คอร์สที่ฉันเป็นผู้สอน</h2>
        <p class="text-sm text-gray-500 mt-1">คอร์สที่คุณสร้างและเผยแพร่บนแพลตฟอร์ม</p>
      </div>
      <a href="/instructor/courses"
        class="hidden sm:block px-4 py-2 bg-black text-white text-sm font-medium rounded-md hover:bg-gray-800 transition">
        จัดการคอร์ส
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% teachingCourses.forEach(course => { %>
        <div class="border border-gray-200 rounded-xl overflow-hidden bg-white flex flex-col h-full relative">

          <!-- Status badge -->
          <span class="absolute top-3 left-3 px-2 py-1 bg-white border border-gray-200 text-xs font-semibold rounded shadow-sm z-10
            <%= course.course_status === 'published' ? 'text-green-700 border-green-200 bg-green-50'
              : course.course_status === 'pending'   ? 'text-yellow-700 border-yellow-200 bg-yellow-50'
              : course.course_status === 'rejected'  ? 'text-red-700 border-red-200 bg-red-50'
              : 'text-gray-700' %>">
            <% if (course.course_status === 'published') { %>เผยแพร่แล้ว
            <% } else if (course.course_status === 'pending') { %>รอการอนุมัติ
            <% } else if (course.course_status === 'rejected') { %>ถูกปฏิเสธ
            <% } else { %>ฉบับร่าง<% } %>
          </span>

          <div class="w-full aspect-video bg-gray-100">
            <% if (course.course_image) { %>
              <img src="<%= course.course_image %>" alt="<%= course.course_name %>" class="w-full h-full object-cover">
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center text-gray-300">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
            <% } %>
          </div>

          <div class="p-4 flex flex-col flex-1">
            <h3 class="font-semibold text-gray-900 line-clamp-2 mb-4"><%= course.course_name %></h3>
            <div class="text-sm text-gray-500 mt-auto border-t border-gray-100 pt-3 flex justify-between items-center">
              <span>ราคา: <span class="font-medium text-gray-900">
                <%= course.course_price > 0 ? '฿' + course.course_price : 'ฟรี' %>
              </span></span>
              <a href="/instructor/courses/<%= course.course_id %>/edit"
                class="text-xs font-semibold text-gray-600 hover:text-black underline underline-offset-2">จัดการ</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <a href="/instructor/courses"
      class="mt-6 block sm:hidden text-center w-full px-4 py-2 bg-black text-white text-sm font-medium rounded-md hover:bg-gray-800 transition">
      จัดการคอร์สทั้งหมด
    </a>
  </section>
  <% } %>

</div>
