<div class="w-full h-40 bg-red-300"></div>

<div class="container max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between px-6 py-6">

    <div class="flex flex-col items-center gap-x-8 md:flex-row">

        <!-- Profile Image -->
        <div class="-mt-15 flex justify-center">
            <div class="h-50 aspect-square md:h-40 rounded-full overflow-hidden bg-white">
                <img src="<%= user.profile_image || '/icon/profile-anonymous.svg' %>"
                    class="w-full h-full object-cover">
            </div>
        </div>

        <!-- Profile Info -->
        <div class="flex flex-col items-center md:items-start text-center md:text-left">

            <h1 class="text-3xl md:text-4xl font-semibold">
                <%= user.username %>
            </h1>

            <p class="text-slate-400">
                <%= user.first_name + " " + user.last_name %>
            </p>
        </div>
    </div>

    <!-- Edit -->
    <div class="h-12 flex items-center mt-3">
        <a href="/users/<%= user.user_id %>/edit" class="px-6 py-2 bg-secondary text-white rounded-md">
            แก้ไขโปรไฟล์
        </a>
    </div>

</div>

<!-- ส่วนดึง database -->

<div class="container max-w-7xl mx-auto px-6">
    <hr class="border-gray-200">
</div>

<div class="container max-w-7xl mx-auto px-6 py-10">
    <h2 class="text-xl font-bold mb-6 text-gray-800">คอร์สของฉัน</h2>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        <% if (enrolledCourses && enrolledCourses.length > 0) { %>
            <% enrolledCourses.forEach(course => { %>
                <a href="/courses/<%= course.course_id %>" class="group flex flex-col gap-3">
                    <div class="overflow-hidden rounded-lg border border-gray-100 shadow-sm">
                        <img src="<%= course.course_image || '/img/course-placeholder.jpg' %>" 
                             class="w-full h-40 object-cover group-hover:scale-105 transition duration-500">
                    </div>
                    <h3 class="font-medium text-gray-900 text-sm group-hover:underline">
                        <%= course.course_name %>
                    </h3>
                </a>
            <% }) %>
        <% } else { %>
            <p class="text-gray-400 text-sm italic">คุณยังไม่ได้ลงทะเบียนเรียนคอร์สใดๆ</p>
        <% } %>
    </div>
</div>