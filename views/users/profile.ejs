<div class="w-full h-40 bg-amber-100"></div>

<div class="container max-w-7xl mx-auto px-6 py-6 pb-20 flex flex-col gap-12">

  <div class="flex flex-col md:flex-row items-center md:items-start justify-between gap-6 border-b border-gray-200 pb-8">

    <div class="flex flex-col items-center md:flex-row gap-6 md:gap-8">
      <div class="-mt-20 flex justify-center shrink-0">
        <div class="h-40 w-40 aspect-square rounded-full overflow-hidden bg-white border-4 border-white shadow-sm">
          <img src="<%= user.profile_image || '/icon/profile-anonymous.svg' %>" class="w-full h-full object-cover">
        </div>
      </div>

      <div class="flex flex-col items-center md:items-start text-center md:text-left mt-2 md:mt-0">
        <h1 class="text-3xl md:text-4xl font-semibold text-gray-900 mb-1">
          <%= user.username || 'Username' %>
        </h1>
        <p class="text-gray-500 text-lg mb-2">
          <%= user.first_name ? user.first_name + " " + user.last_name : 'ชื่อ นามสกุล' %>
        </p>
        <span class="inline-block px-3 py-1 bg-gray-100 text-gray-700 text-xs font-medium rounded-md">
          ผู้สอน (Instructor)
        </span>
      </div>
    </div>

    <div class="mt-4 md:mt-0">
      <a href="/users/<%= user.user_id %>/edit" class="px-6 py-2.5 bg-secondary text-white rounded-md hover:opacity-90 transition font-medium inline-block text-center w-full md:w-auto">
        แก้ไขโปรไฟล์
      </a>
    </div>

  </div>

  <section>
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl md:text-2xl font-bold text-gray-900">
        คอร์สที่กำลังเรียน
      </h2>
      <a href="/my-learning" class="text-secondary hover:underline font-medium">
        ดูทั้งหมด
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <div class="border border-gray-200 rounded-lg overflow-hidden bg-white flex flex-col h-full">
        <div class="w-full aspect-video bg-gray-100">
          <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Course" class="w-full h-full object-cover">
        </div>
        <div class="p-4 flex flex-col flex-1">
          <h3 class="font-semibold text-gray-900 line-clamp-2 mb-2">
            Complete Web Development Bootcamp 2024
          </h3>
          <p class="text-sm text-gray-500 mb-4">เรียนไปแล้ว 45%</p>
          
          <div class="w-full bg-gray-200 rounded-full h-1.5 mb-4 mt-auto">
            <div class="bg-secondary h-1.5 rounded-full" style="width: 45%"></div>
          </div>
          
          <a href="#" class="block text-center w-full px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition text-sm">
            เรียนต่อ
          </a>
        </div>
      </div>

      <div class="border border-gray-200 rounded-lg overflow-hidden bg-white flex flex-col h-full">
        <div class="w-full aspect-video bg-gray-100">
          <img src="https://images.unsplash.com/photo-1618477247222-ac60ceb02566?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Course" class="w-full h-full object-cover">
        </div>
        <div class="p-4 flex flex-col flex-1">
          <h3 class="font-semibold text-gray-900 line-clamp-2 mb-2">
            Mastering UI/UX Design with Figma
          </h3>
          <p class="text-sm text-gray-500 mb-4">เรียนไปแล้ว 10%</p>
          
          <div class="w-full bg-gray-200 rounded-full h-1.5 mb-4 mt-auto">
            <div class="bg-secondary h-1.5 rounded-full" style="width: 10%"></div>
          </div>
          
          <a href="#" class="block text-center w-full px-4 py-2 border border-gray-300 text-gray-700 rounded-md hover:bg-gray-50 transition text-sm">
            เรียนต่อ
          </a>
        </div>
      </div>

    </div>
  </section>

  <section>
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl md:text-2xl font-bold text-gray-900">
          คอร์สที่ฉันเป็นผู้สอน
        </h2>
        <p class="text-sm text-gray-500 mt-1">คอร์สที่คุณสร้างและเผยแพร่บนแพลตฟอร์ม</p>
      </div>
      <a href="/instructor/courses" class="hidden sm:block px-4 py-2 bg-secondary text-white text-sm font-medium rounded-md hover:opacity-90 transition">
        จัดการคอร์ส
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <div class="border border-gray-200 rounded-lg overflow-hidden bg-white flex flex-col h-full relative">
        <span class="absolute top-3 left-3 px-2 py-1 bg-white border border-gray-200 text-gray-700 text-xs font-semibold rounded shadow-sm z-10">
          เผยแพร่แล้ว
        </span>

        <div class="w-full aspect-video bg-gray-100">
          <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Course" class="w-full h-full object-cover">
        </div>
        
        <div class="p-4 flex flex-col flex-1">
          <h3 class="font-semibold text-gray-900 line-clamp-2 mb-4">
            Node.js & Express: แบ็กเอนด์ตั้งแต่ศูนย์
          </h3>
          <div class="text-sm text-gray-500 mt-auto border-t border-gray-100 pt-3">
            นักเรียนทั้งหมด: <span class="font-medium text-gray-900">120 คน</span>
          </div>
        </div>
      </div>

    </div>

    <a href="/instructor/courses" class="mt-6 block sm:hidden text-center w-full px-4 py-2 bg-secondary text-white text-sm font-medium rounded-md hover:opacity-90 transition">
      จัดการคอร์สทั้งหมด
    </a>

  </section>

</div>