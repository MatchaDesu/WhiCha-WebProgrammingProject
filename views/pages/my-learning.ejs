<!-- ส่วนดึง database การเรียน -->

<div class="container max-w-7xl mx-auto px-6">
    <hr class="border-gray-200">
</div>

<div class="container max-w-7xl mx-auto px-6 py-10">
    <h2 class="text-xl font-bold mb-6 text-gray-800">คอร์สของฉัน</h2>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        <% if (enrolledCourses && enrolledCourses.length > 0) { %>
            <% enrolledCourses.forEach(course => { %>
                <a href="/courses/<%= course.course_id %>" class="group flex flex-col gap-3">
                    <div class="overflow-hidden rounded-lg border border-gray-100 shadow-sm">
                        <img src="<%= course.course_image || '/img/course-placeholder.jpg' %>" 
                             class="w-full h-40 object-cover group-hover:scale-105 transition duration-500">
                    </div>
                    <h3 class="font-medium text-gray-900 text-sm group-hover:underline">
                        <%= course.course_name %>
                    </h3>
                </a>
            <% }) %>
        <% } else { %>
            <p class="text-gray-400 text-sm italic">คุณยังไม่ได้ลงทะเบียนเรียนคอร์สใดๆ</p>
        <% } %>
    </div>
</div>